# .github/workflows/deploy.yml
# Ditto 部署工作流
#
# 支持：
# - Staging：main 分支自动部署
# - Production：release tag 触发，需审批

name: Deploy

on:
  # main 分支 CI 成功后触发 staging 部署
  workflow_run:
    workflows: ["CI"]
    types: [completed]
    branches: [main]

  # Release 发布触发 production 部署
  release:
    types: [published]

  # 手动触发
  workflow_dispatch:
    inputs:
      environment:
        description: "Target environment"
        required: true
        type: choice
        options:
          - staging
          - production
      version:
        description: "Version/tag to deploy (for production)"
        required: false
        type: string

jobs:
  # ============================================================
  # 确定部署目标
  # ============================================================
  prepare:
    name: Prepare Deployment
    runs-on: ubuntu-latest
    outputs:
      environment: ${{ steps.determine.outputs.environment }}
      version: ${{ steps.determine.outputs.version }}
      should_deploy: ${{ steps.determine.outputs.should_deploy }}
    steps:
      - name: Determine deployment target
        id: determine
        run: |
          # 手动触发
          if [[ "${{ github.event_name }}" == "workflow_dispatch" ]]; then
            echo "environment=${{ inputs.environment }}" >> $GITHUB_OUTPUT
            echo "version=${{ inputs.version || github.sha }}" >> $GITHUB_OUTPUT
            echo "should_deploy=true" >> $GITHUB_OUTPUT
          # Release 发布
          elif [[ "${{ github.event_name }}" == "release" ]]; then
            echo "environment=production" >> $GITHUB_OUTPUT
            echo "version=${{ github.event.release.tag_name }}" >> $GITHUB_OUTPUT
            echo "should_deploy=true" >> $GITHUB_OUTPUT
          # CI 成功后自动部署 staging
          elif [[ "${{ github.event.workflow_run.conclusion }}" == "success" ]]; then
            echo "environment=staging" >> $GITHUB_OUTPUT
            echo "version=${{ github.sha }}" >> $GITHUB_OUTPUT
            echo "should_deploy=true" >> $GITHUB_OUTPUT
          else
            echo "should_deploy=false" >> $GITHUB_OUTPUT
          fi

  # ============================================================
  # Staging 部署
  # ============================================================
  deploy-staging:
    name: Deploy to Staging
    needs: prepare
    if: ${{ needs.prepare.outputs.should_deploy == 'true' && needs.prepare.outputs.environment == 'staging' }}
    runs-on: ubuntu-latest
    environment:
      name: staging
      url: https://staging.ditto.example.com
    steps:
      - uses: actions/checkout@v4

      - name: Setup Pixi
        uses: prefix-dev/setup-pixi@v0.8.1
        with:
          pixi-version: v0.39.5
          cache: true

      # Docker 构建
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push
        uses: docker/build-push-action@v6
        with:
          context: .
          file: deploy/Dockerfile
          push: true
          tags: |
            ghcr.io/${{ github.repository }}:staging
            ghcr.io/${{ github.repository }}:${{ needs.prepare.outputs.version }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          build-args: |
            PYTHON_VERSION=3.12
            BUILD_VERSION=${{ needs.prepare.outputs.version }}

      # 部署（示例：使用 SSH）
      - name: Deploy to staging server
        uses: appleboy/ssh-action@v1.2.0
        with:
          host: ${{ secrets.STAGING_HOST }}
          username: ${{ secrets.STAGING_USER }}
          key: ${{ secrets.STAGING_SSH_KEY }}
          script: |
            cd /opt/ditto
            docker compose pull
            docker compose up -d
            sleep 10
            docker compose exec -T server python -c "from ditto_foundation.observability import get_logger; print('Health check passed')"

      # 部署后验证
      - name: Smoke test
        run: |
          sleep 15
          curl -f https://staging.ditto.example.com/api/health || exit 1

      # 通知可观测性平台
      - name: Notify deployment
        if: always()
        run: |
          curl -X POST "${{ secrets.OBSERVABILITY_WEBHOOK }}" \
            -H "Content-Type: application/json" \
            -d '{
              "event": "deployment",
              "service": "ditto",
              "environment": "staging",
              "version": "${{ needs.prepare.outputs.version }}",
              "status": "${{ job.status }}",
              "actor": "${{ github.actor }}"
            }' || true

  # ============================================================
  # Production 部署
  # ============================================================
  deploy-production:
    name: Deploy to Production
    needs: prepare
    if: ${{ needs.prepare.outputs.should_deploy == 'true' && needs.prepare.outputs.environment == 'production' }}
    runs-on: ubuntu-latest
    environment:
      name: production
      url: https://ditto.example.com
    # Environment protection rules 会自动要求审批
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ needs.prepare.outputs.version }}

      # 验证版本已通过 CI
      - name: Verify CI status
        run: |
          gh run list \
            --commit $(git rev-parse HEAD) \
            --workflow=ci.yml \
            --json conclusion \
            -q '.[0].conclusion' | grep -q 'success' || {
              echo "::error::CI has not passed for this version"
              exit 1
            }
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push
        uses: docker/build-push-action@v6
        with:
          context: .
          file: deploy/Dockerfile
          push: true
          tags: |
            ghcr.io/${{ github.repository }}:latest
            ghcr.io/${{ github.repository }}:${{ needs.prepare.outputs.version }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Deploy to production
        uses: appleboy/ssh-action@v1.2.0
        with:
          host: ${{ secrets.PROD_HOST }}
          username: ${{ secrets.PROD_USER }}
          key: ${{ secrets.PROD_SSH_KEY }}
          script: |
            cd /opt/ditto

            # 备份当前版本
            docker tag ghcr.io/${{ github.repository }}:current \
                       ghcr.io/${{ github.repository }}:rollback 2>/dev/null || true

            # 部署新版本
            docker compose pull
            docker compose up -d

            # 健康检查
            sleep 20
            docker compose exec -T server python -c "from ditto_foundation.observability import get_logger; print('Production health check passed')"

      - name: Notify success
        if: success()
        run: |
          curl -X POST "${{ secrets.OBSERVABILITY_WEBHOOK }}" \
            -H "Content-Type: application/json" \
            -d '{
              "event": "deployment",
              "service": "ditto",
              "environment": "production",
              "version": "${{ needs.prepare.outputs.version }}",
              "status": "success",
              "deployed_by": "${{ github.actor }}"
            }'

  # ============================================================
  # 回滚（仅 production 失败时）
  # ============================================================
  rollback:
    name: Rollback on Failure
    needs: [prepare, deploy-production]
    if: ${{ failure() && needs.prepare.outputs.environment == 'production' }}
    runs-on: ubuntu-latest
    steps:
      - name: Execute rollback
        uses: appleboy/ssh-action@v1.2.0
        with:
          host: ${{ secrets.PROD_HOST }}
          username: ${{ secrets.PROD_USER }}
          key: ${{ secrets.PROD_SSH_KEY }}
          script: |
            cd /opt/ditto
            docker tag ghcr.io/${{ github.repository }}:rollback \
                       ghcr.io/${{ github.repository }}:current 2>/dev/null || true
            docker compose up -d
            echo "Rollback completed"

      - name: Notify rollback
        run: |
          curl -X POST "${{ secrets.OBSERVABILITY_WEBHOOK }}" \
            -H "Content-Type: application/json" \
            -d '{
              "event": "rollback",
              "service": "ditto",
              "environment": "production",
              "failed_version": "${{ needs.prepare.outputs.version }}",
              "status": "rollback_executed"
            }' || true
