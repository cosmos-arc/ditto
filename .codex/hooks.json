{
  "description": "Ditto fast interactive guardrails; quality gates run via explicit check-changed and CI",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/tooling/agent_harness/hook.py\" --host codex --event pre-tool",
            "timeout": 10,
            "statusMessage": "Checking Ditto command policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/tooling/agent_harness/hook.py\" --host codex --event post-tool",
            "timeout": 10,
            "statusMessage": "Formatting edited Python files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/tooling/agent_harness/hook.py\" --host codex --event stop",
            "timeout": 3,
            "statusMessage": "Checking pending changes"
          }
        ]
      }
    ]
  }
}
