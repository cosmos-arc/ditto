# ===================================================================
#      通用 Python & 包管理 (Generic Python & Package Management)
# ===================================================================

# 字节码或编译文件
__pycache__/
*.py[cod]
*$py.class

# C 语言扩展
*.so

# 发行版/打包
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 安装日志
pip-log.txt
pip-delete-this-directory.txt

# 虚拟环境
# 常见的虚拟环境目录名，如果您的环境目录名不同，请自行修改
venv/
.venv/
env/
.env/
ENV/
.direnv/

# Poetry, Pipenv 和其他工具
poetry.lock
.pnp.js
.pnp.loader.mjs

# ===================================================================
#                Pixi 包管理 (Pixi Package Manager)
# ===================================================================
# Pixi 在初始化时通常会自动创建或更新 .gitignore
# 以下是为确保 Pixi 环境目录被忽略的核心规则
.pixi/

# ===================================================================
#       AI & 数据科学 (AI & Data Science)
# ===================================================================

# Jupyter Notebook 检查点
.ipynb_checkpoints

# IPython Profile
profile_default/
ipython_config.py

# scikit-learn / aiohttp 等库的缓存
*.joblib

# 大型数据文件
# 建议使用 Git LFS (Large File Storage) 来管理大型数据文件
# 这里默认忽略常见的数据格式，请根据您的项目情况调整
*.csv
*.json
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle
*.dat

# 只忽略根目录下的 data 目录
/data
datasets/
assets/

# 模型文件
# 模型文件通常较大，不建议直接存入 Git
models/
*.model
*.pt
*.pth
*.pb
*.onnx

# 缓存文件
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ===================================================================
#                 Web 框架 (Web Frameworks)
# ===================================================================

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask & FastAPI
instance/
.webassets-cache

# 静态文件和媒体文件 (通常由构建流程生成)
staticfiles/
media/

# ===================================================================
#              开发工具 & 编辑器 (Dev Tools & Editors)
# ===================================================================

# PyCharm
.idea/
*.iml

# Visual Studio Code
.vscode/
*.code-workspace

# 本地配置文件 (用于存储敏感信息，如 API 密钥)
.env
.env.*
!.env.example
!,.env.template
config.local.py
local.settings.json

# 操作系统/桌面文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===================================================================
#                         测试报告 (Test Reports)
# ===================================================================
htmlcov/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*,cover
*.lcov
report.xml
*.html

# ===================================================================
