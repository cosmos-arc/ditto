# ===================================================================
#      通用 Python & 包管理 (Generic Python & Package Management)
# ===================================================================

__pycache__/
*.py[cod]
*$py.class
*.so

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# lib/ 来自 Python 构建模板，会误伤已跟踪的 web 源码目录（apps/web/src/lib）
!apps/web/src/**/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

pip-log.txt
pip-delete-this-directory.txt

# 虚拟环境
venv/
.venv/
env/
.env/
ENV/
.direnv/

# 已退役工具链目录仍保留忽略：旧 worktree 更新后残留的 .pixi/ 不进入
# untracked 变更集（check-changed 会枚举全部未忽略文件）
.pixi/

# ===================================================================
#                    缓存目录 (Cache Directories)
# ===================================================================
.pytest_cache/
.ruff_cache/
.hypothesis/
.mypy_cache/
.pyright_cache/
.basedpyright/
.grimp_cache/
.import_linter_cache/
.benchmarks/
.cache/ditto-dev/
.cache/ditto-system/
/node_modules/

# ===================================================================
#                    测试报告 (Test Reports)
# ===================================================================
htmlcov/
.coverage
.coverage.*
*.lcov
report.xml
coverage.xml
coverage.json

# ===================================================================
#                    数据文件（混合策略）
# ===================================================================

# 包内数据目录
packages/*/data/

# SQLite 数据库
*.sqlite
*.sqlite-journal
*.sqlite-wal

/data
/datasets/
/models/

# Visual audit 运行输出（writer 默认写入归档树内，报告可按需 git add -f 提交）
docs/archive/web/reviews/visual-audit/
/.tmp/

# 大型数据文件
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle
*.dat

# CSV/JSON 精确忽略
/*.csv
/*.json
!/package.json
config/**/*.json
!config/**/*.example.json

# ===================================================================
#                    Jupyter & IPython
# ===================================================================
.ipynb_checkpoints
profile_default/
ipython_config.py

# ===================================================================
#                    Web 框架 (Web Frameworks)
# ===================================================================
logs/
*.log
instance/
.webassets-cache

# Django
local_settings.py
db.sqlite3
db.sqlite3-journal

# ===================================================================
#                    开发工具 (Dev Tools & Editors)
# ===================================================================
.idea/
.vscode/
*.code-workspace

# 本地配置
.env
.env.*
!.env.template
config.local.py
local.settings.json

# Docker 部署环境变量(敏感信息)
.env.local
deploy/docker/.env.local

# ===================================================================
#                    操作系统 (Operating Systems)
# ===================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.codex/*
!.codex/hooks.json
.zcode/*
!.zcode/config.json
.cache/ditto-agent-harness/
.worktrees/
.merge-backups/
# Mutmut creates an importable shadow source tree per Python capability package.
mutants/

.cache/
# New acceptance runs are local output. Existing tracked evidence stays tracked;
# promoting a new evidence file requires an explicit, reviewed git add -f.
/artifacts/
