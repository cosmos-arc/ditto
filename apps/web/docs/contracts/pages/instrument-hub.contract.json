  },
  "viewports": [
    {
      "width": 1536,
      "height": 900,
      "role": "primary"
    },
    {
      "width": 1366,
      "height": 768,
      "role": "compact"
    }
  ],
  "slots": [
    {
      "name": "meta",
      "required": true,
      "prototypeSelector": ".object-meta",
      "reactSelector": "[data-slot='meta']",
      "a11yRole": "banner",
      "responsiveBehavior": {
        "compact": "reflow"
      }
    },
    {
      "name": "tabs",
      "required": true,
      "prototypeSelector": ".object-tabs",
      "reactSelector": "[data-slot='tabs']",
      "a11yRole": "navigation",
      "responsiveBehavior": {
        "compact": "reflow"
      }
    },
    {
      "name": "main",
      "required": true,
      "prototypeSelector": ".object-main",
      "reactSelector": "[data-slot='main']",
      "a11yRole": "main"
    },
    {
      "name": "bottom",
      "required": true,
      "prototypeSelector": ".object-bottom",
      "reactSelector": "[data-slot='bottom']",
      "a11yRole": "region",
      "responsiveBehavior": {
        "compact": "collapsed"
      }
    }
  ],
  "states": {
    "universal": [
      "loading",
      "empty",
      "error",
      "stale"
    ],
    "pageSpecific": [
      "not-found"
    ]
  },
  "flags": {
    "hasStatusBar": true,
    "sidebarCollapsible": false
  },
