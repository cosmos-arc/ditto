      "responsiveBehavior": { "compact": "collapsed" }
    },
    {
      "name": "scope-strip",
      "required": true,
      "prototypeSelector": ".scope-strip",
      "reactSelector": "[data-slot='scope-strip']",
      "a11yRole": "status",
      "threshold": { "x": 4, "y": 4, "widthRatio": 0.01, "heightRatio": 1 },
      "responsiveBehavior": { "compact": "collapsed" }
    },
    {
      "name": "main",
      "required": true,
      "prototypeSelector": ".main-content",
      "reactSelector": "[data-slot='main']",
      "a11yRole": "main",
      "threshold": { "x": 4, "y": 70, "widthRatio": 0.01, "heightRatio": 0.74 }
