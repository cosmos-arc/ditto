      "responsiveBehavior": { "compact": "reflow" }
    }
  ],
  "states": {
    "universal": ["loading", "empty", "error", "stale"],
    "pageSpecific": ["catalog-empty", "partial-page", "price-evidence-unavailable", "identity-only"]
  },
  "flags": { "hasStatusBar": true, "sidebarCollapsible": false },
  "metrics": {
    "capturedAt": "2026-04-27",
