  },
  "viewports": [
    {
      "width": 1536,
      "height": 1080,
      "role": "primary"
    },
    {
      "width": 1366,
      "height": 768,
      "role": "compact"
    }
  ],
  "slots": [
    {
      "name": "header",
      "required": true,
      "prototypeSelector": ".alpha-header",
      "reactSelector": "[data-slot='header']",
      "a11yRole": "banner",
      "responsiveBehavior": {
        "compact": "reflow"
      }
    },
    {
      "name": "source",
      "required": true,
      "prototypeSelector": ".config-panel",
      "reactSelector": "[data-slot='source']",
      "a11yRole": "complementary",
      "responsiveBehavior": {
        "compact": "collapsed"
      }
    },
    {
      "name": "main",
      "required": true,
      "prototypeSelector": ".stream-panel",
      "reactSelector": "[data-slot='main']",
      "a11yRole": "main"
    },
    {
      "name": "inspector",
      "required": true,
      "prototypeSelector": ".inspector",
      "reactSelector": "[data-slot='inspector']",
      "a11yRole": "complementary",
      "responsiveBehavior": {
        "compact": "overlay"
      }
    },
    {
      "name": "adoption",
      "required": true,
      "prototypeSelector": ".queue-panel",
      "reactSelector": "[data-slot='adoption']",
      "a11yRole": "complementary",
      "responsiveBehavior": {
        "compact": "collapsed"
      }
    },
    {
      "name": "graph",
      "required": true,
      "prototypeSelector": ".graph-panel",
      "reactSelector": "[data-slot='graph']",
      "a11yRole": "region",
      "responsiveBehavior": {
        "compact": "collapsed"
      }
    }
  ],
  "states": {
    "universal": [
      "loading",
      "empty",
      "error",
      "stale"
    ],
    "pageSpecific": [
      "running",
      "partial",
      "blocked",
      "waiting-approval",
      "budget-exceeded"
    ]
  },
  "flags": {
    "hasStatusBar": false,
    "sidebarCollapsible": false
  },
  "metrics": {
    "capturedAt": "2026-05-02",
    "viewport": "1536x900",
    "baseline": {
      "source": {
        "width": 276,
        "height": 660,
        "strategy": "fixed-width"
      },
      "main": {
        "width": 808,
        "height": 660,
        "strategy": "content-driven"
      },
      "inspector": {
        "width": 360,
        "height": 832,
        "strategy": "fixed-width"
      }
    }
  },
  "visualThresholds": {
    "consoleErrors": 0,
    "pageErrors": 0,
    "missingSelectors": 0,
    "targetMismatch": 0,
    "pixelDiffRatio": 0.02
  },
  "overlays": [
    {
      "id": "alpha-explorer.explore-run-create",
      "kind": "sheet",
      "blocking": false,
      "requiredInDefaultFlow": true,
      "trigger": {
        "slot": "header",
        "action": "start-run"
      },
      "prototypeSelector": "#overlay-explore-run-create",
      "reactComponent": "PrototypeOnlyOverlay",
      "closeBehavior": [
        "escape",
        "outside-click",
        "primary-action"
      ]
    },
    {
      "id": "alpha-explorer.candidate-deep-dive",
      "kind": "drawer",
      "blocking": false,
      "requiredInDefaultFlow": true,
      "trigger": {
        "slot": "main",
        "action": "open-candidate"
      },
      "prototypeSelector": "#overlay-candidate-deep-dive",
      "reactComponent": "PrototypeOnlyOverlay",
      "closeBehavior": [
        "escape",
        "outside-click",
        "primary-action"
      ]
    },
    {
      "id": "alpha-explorer.adoption-confirm",
      "kind": "modal",
      "blocking": true,
