{
  "id": "alpha-explorer",
  "version": 1,
  "status": "draft",
  "createdAt": "2026-05-02",
  "updatedAt": "2026-05-03",
  "route": "/research/alpha",
  "pagePattern": "studio-builder",
  "shellFamily": "studio",
  "prototypeRef": "docs/designs/specs/prototypes/page-alpha-explorer.html",
