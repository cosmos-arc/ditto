{
  "id": "agent-console",
  "version": 2,
  "status": "draft",
  "createdAt": "2026-04-27",
  "updatedAt": "2026-05-02",
  "route": "/platform/agents",
  "pagePattern": "studio-builder",
  "shellFamily": "studio",
  "prototypeRef": "docs/designs/specs/prototypes/page-agent-console-v2.html",
  "blueprintRefs": [
    "02_core_page_blueprints.md#15-agent-console"
  ],
  "landing": {
    "reactRouteStatus": "missing",
    "featureModule": "src/features/platform",
    "contractStatus": "draft",
    "overlayStatus": "triggerable",
    "visualAuditStatus": "missing"
  },
  "viewports": [
    {
      "width": 1536,
      "height": 900,
      "role": "primary"
    },
    {
      "width": 1366,
      "height": 768,
      "role": "compact"
    }
  ],
  "slots": [
    {
      "name": "header",
      "required": true,
      "prototypeSelector": ".agent-header",
      "reactSelector": "[data-slot='header']",
      "a11yRole": "banner",
      "responsiveBehavior": {
        "compact": "collapsed"
      }
    },
    {
      "name": "tabs",
      "required": true,
      "prototypeSelector": ".agent-tabs",
      "reactSelector": "[data-slot='tabs']",
      "a11yRole": "tablist",
      "responsiveBehavior": {
        "compact": "reflow"
      }
    },
    {
      "name": "source",
      "required": true,
      "prototypeSelector": ".list-panel",
      "reactSelector": "[data-slot='source']",
      "a11yRole": "complementary",
      "responsiveBehavior": {
        "compact": "collapsed"
      }
    },
    {
      "name": "main",
      "required": true,
      "prototypeSelector": ".main-panel",
      "reactSelector": "[data-slot='main']",
      "a11yRole": "main"
    },
    {
      "name": "inspector",
      "required": true,
      "prototypeSelector": ".inspector",
      "reactSelector": "[data-slot='inspector']",
      "a11yRole": "complementary",
      "responsiveBehavior": {
        "compact": "overlay"
      }
    }
  ],
  "states": {
    "universal": [
      "loading",
      "empty",
      "error",
      "stale"
    ],
    "pageSpecific": [
      "no-agents",
      "agent-running",
      "partial",
      "blocked",
      "waiting-approval",
      "guardrail-blocked",
      "quality-run"
    ]
  },
  "flags": {
    "hasStatusBar": true,
    "sidebarCollapsible": false
  },
  "metrics": {
    "capturedAt": "2026-04-27",
    "viewport": "1536x900",
    "baseline": {
      "health": {
        "width": 1536,
        "height": 72,
        "strategy": "content-driven"
      },
      "main": {
        "width": 1110,
        "height": 720,
        "strategy": "content-driven"
      },
      "detail": {
        "width": 360,
        "height": 720,
        "strategy": "fixed-width"
      }
    }
  },
  "visualThresholds": {
    "consoleErrors": 0,
    "pageErrors": 0,
    "missingSelectors": 0,
    "targetMismatch": 0,
    "pixelDiffRatio": 0.02
  },
