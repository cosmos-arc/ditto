  "states": {
    "universal": ["loading", "empty", "error", "stale"],
    "pageSpecific": [
      "selected-nav-tab",
      "selected-report-tab",
      "selected-trades-tab",
      "selected-audit-tab",
      "run-unavailable",
      "report-unavailable",
      "performance-unpublished",
      "nav-unavailable",
      "benchmark-unpublished",
      "benchmark-unavailable",
      "trades-empty",
      "trades-unavailable",
      "audit-empty",
      "audit-unavailable"
    ]
  },
  "interactions": [
    {
      "id": "switch-backtest-evidence-view",
      "trigger": "tab-change",
      "affectedSlots": ["tabs", "main", "bottom"],
      "expectedBehavior": "switches among NAV, published report, exact trades, and audit evidence while retaining the frozen run and strategy-version identity"
    },
    {
      "id": "request-agent-evidence-analysis",
      "trigger": "header-evidence-action",
      "affectedSlots": ["header"],
      "expectedBehavior": "opens the governed Agent entry with the exact run, strategy, and version context instead of generating an ungoverned inline interpretation"
    },
    {
      "id": "retry-backtest-run",
      "trigger": "typed-run-retry-action",
      "affectedSlots": ["meta", "tabs", "main", "bottom"],
      "expectedBehavior": "retries run identity and withholds every result resource until the run is confirmed"
    },
    {
      "id": "retry-backtest-resource",
      "trigger": "typed-resource-retry-action",
      "affectedSlots": ["meta", "main", "bottom"],
      "expectedBehavior": "retries only the failed report, NAV, benchmark, trades, or audit resource and never substitutes zeros, holdings, names, or monthly returns"
    }
  ],
