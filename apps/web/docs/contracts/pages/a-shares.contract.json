      "responsiveBehavior": { "compact": "collapsed" }
    },
    {
      "name": "main",
      "required": true,
      "prototypeSelector": ".main-content",
      "reactSelector": "[data-slot='main']",
      "a11yRole": "main",
      "threshold": { "x": 4, "y": 20, "widthRatio": 0.01, "heightRatio": 0.56 }
    },
    {
      "name": "activity",
      "required": true,
      "prototypeSelector": ".right-rail",
      "reactSelector": "[data-slot='activity']",
      "a11yRole": "complementary",
      "threshold": { "x": 8, "y": 20, "widthRatio": 0.03, "heightRatio": 0.56 },
      "responsiveBehavior": { "compact": "overlay" }
    }
  ],
  "states": {
    "universal": ["loading", "empty", "error", "stale"],
    "pageSpecific": ["no-active-stocks", "exchange-empty", "price-evidence-unavailable"]
  },
  "flags": { "hasStatusBar": false, "sidebarCollapsible": false },
  "metrics": {
    "capturedAt": "2026-04-27",
    "viewport": "1536x900",
    "baseline": {
