{
  "id": "home",
  "version": 1,
  "status": "draft",
  "createdAt": "2026-04-16",
  "updatedAt": "2026-04-16",

  "route": "/",
  "pagePattern": "global-command-center",
  "shellFamily": "command-center",
  "prototypeRef": "docs/designs/specs/prototypes/page-home.html",
  "blueprintRefs": ["02_core_page_blueprints.md#home-command-center"],

  "viewports": [
    { "width": 1536, "height": 900, "role": "primary" },
    { "width": 1366, "height": 768, "role": "compact" }
  ],

  "slots": [
    {
      "name": "pulse",
      "required": true,
      "infoLevel": "l2",
      "prototypeSelector": ".shell-pulse",
      "reactSelector": "[data-slot='pulse-strip']",
      "layoutStrategy": "content-driven",
      "threshold": { "x": 4, "y": 4, "widthRatio": 0.03, "heightRatio": 0.05 }
    },
    {
      "name": "main",
      "required": true,
      "infoLevel": "l2",
      "prototypeSelector": ".shell-main",
      "reactSelector": "[data-slot='main']",
      "layoutStrategy": "content-driven",
      "threshold": { "x": 4, "y": 4, "widthRatio": 0.03, "heightRatio": 0.05 }
    },
    {
      "name": "sidebar",
      "required": true,
      "infoLevel": "l2",
      "prototypeSelector": ".shell-sidebar",
      "reactSelector": "[data-slot='sidebar-rail']",
      "layoutStrategy": "fixed-width",
      "threshold": { "x": 4, "y": 4, "widthRatio": 0.03, "heightRatio": 0.05 }
    }
  ],

  "subSlots": [
    {
      "name": "decision-banner",
      "parentSlot": "main",
      "infoLevel": "l2",
      "prototypeSelector": ".decision-banner",
      "reactSelector": "[data-slot='decision-banner']",
      "threshold": { "widthRatio": 0.05, "heightRatio": 0.05 }
    },
    {
      "name": "priority-queue",
      "parentSlot": "main",
      "infoLevel": "l2",
      "prototypeSelector": ".panel-grow",
      "reactSelector": "[data-testid='priority-queue']",
      "threshold": { "widthRatio": 0.05, "heightRatio": 0.05 }
    },
    {
      "name": "secondary",
      "parentSlot": "main",
      "infoLevel": "l0",
      "prototypeSelector": ".shell-secondary",
      "reactSelector": "[data-slot='home-secondary']",
      "threshold": { "widthRatio": 0.05, "heightRatio": 0.05 }
    }
  ],

  "states": {
    "universal": ["loading", "empty", "error", "stale"],
    "pageSpecific": ["no-alerts", "has-critical"]
  },

  "interactions": [
    {
      "id": "sidebar-collapse",
      "trigger": "sidebar-toggle",
      "affectedSlots": ["sidebar", "main"],
      "expectedBehavior": "sidebar width changes and main area expands"
    }
  ],

  "flags": {
    "hasStatusBar": false,
    "sidebarCollapsible": true
  },

  "metrics": {
    "capturedAt": "2026-04-16",
    "viewport": "1536x900",
    "baseline": {
      "pulse": { "width": 1536, "height": 0, "strategy": "content-driven" },
      "main": { "width": 1200, "height": 0, "strategy": "content-driven" },
      "sidebar": { "width": 260, "height": 900, "strategy": "fixed-width" }
    }
  },

  "visualThresholds": {
    "consoleErrors": 0,
    "pageErrors": 0,
    "missingSelectors": 0,
    "targetMismatch": 0,
    "pixelDiffRatio": 0.02
  }
}
