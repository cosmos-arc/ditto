{
  "id": "platform",
  "version": 2,
  "status": "contract-ready",
  "createdAt": "2026-04-27",
  "updatedAt": "2026-08-18",
  "route": "/platform",
  "pagePattern": "queue-ops-console",
  "shellFamily": "ops-console",
  "prototypeRef": "docs/designs/specs/prototypes/page-platform.html",
  "landing": {
    "reactRouteStatus": "implemented",
    "featureModule": "src/features/platform",
    "contractStatus": "draft",
    "overlayStatus": "triggerable",
    "visualAuditStatus": "verified",
    "reactTestRefs": [
      "src/features/platform/components/platform-components.test.tsx",
      "src/features/platform/components/info-level-annotations.test.tsx",
      "src/features/platform/hooks/platform-hooks.test.tsx"
    ],
    "reactComponentRefs": [
      "PlatformPage"
    ]
  },
  "liveData": {
    "readPaths": [
      "/api/v1/ingestion/catalog/remediation/backlog",
      "/api/v1/ingestion/catalog/remediation/items/{item_id}",
      "/api/v1/ingestion/catalog/remediation/approvals",
      "/api/v1/ingestion/catalog/source-health",
      "/api/v1/ingestion/catalog/source-health/summary",
      "/api/v1/ingestion/catalog/source-fallback/summary",
      "/api/v1/ingestion/catalog/source-fallback/policies",
      "/api/v1/ingestion/catalog/promotion/readiness",
      "/api/v1/ingestion/catalog/promotion/history"
    ],
    "writePaths": [
      "/api/v1/ingestion/catalog/remediation/approvals",
      "/api/v1/ingestion/catalog/remediation/approvals/{approval_id}/decision",
      "/api/v1/ingestion/catalog/remediation/approvals/{approval_id}/execute",
      "/api/v1/ingestion/catalog/source-fallback/policies",
      "/api/v1/ingestion/catalog/source-fallback/policies/{policy_id}/approval",
      "/api/v1/ingestion/catalog/source-fallback/policies/{policy_id}/activation",
      "/api/v1/ingestion/catalog/source-fallback/policies/{policy_id}/retirement",
      "/api/v1/ingestion/catalog/promotion/revoke"
    ],
    "mockFallback": false
  },
  "viewports": [
    {
      "width": 1536,
      "height": 900,
      "role": "primary"
    },
    {
      "width": 1366,
      "height": 768,
      "role": "compact"
    }
  ],
  "slots": [
    {
      "name": "health",
      "required": true,
      "prototypeSelector": ".ops-health",
      "reactSelector": "[data-slot='health']",
      "a11yRole": "banner",
      "responsiveBehavior": {
        "compact": "collapsed"
      }
    },
    {
      "name": "main",
      "required": true,
      "prototypeSelector": ".ops-main",
      "reactSelector": "[data-slot='main']",
      "a11yRole": "main"
    },
    {
      "name": "detail",
      "required": true,
      "prototypeSelector": ".ops-detail",
      "reactSelector": "[data-slot='detail']",
      "a11yRole": "complementary",
      "responsiveBehavior": {
        "compact": "overlay"
      }
    }
  ],
  "states": {
    "universal": [
      "loading",
      "empty",
      "error",
      "stale"
    ],
    "pageSpecific": [
      "pipeline-running",
      "source-degraded",
      "fallback-active",
      "promotion-blocked",
      "approval-expired",
      "remediation-empty"
    ]
  },
  "flags": {
    "hasStatusBar": true,
    "sidebarCollapsible": false
  },
  "metrics": {
    "capturedAt": "2026-04-27",
    "viewport": "1536x900",
    "baseline": {
      "health": {
        "width": 1536,
        "height": 72,
        "strategy": "content-driven"
      },
      "main": {
        "width": 1110,
        "height": 720,
        "strategy": "content-driven"
      },
      "detail": {
        "width": 360,
        "height": 720,
        "strategy": "fixed-width"
      }
    }
  },
  "visualThresholds": {
    "consoleErrors": 0,
    "pageErrors": 0,
    "missingSelectors": 0,
    "targetMismatch": 0,
    "pixelDiffRatio": 0.02
  },
  "overlays": [
    {
      "id": "platform.pipeline-rerun",
      "kind": "sheet",
      "blocking": false,
      "requiredInDefaultFlow": true,
      "trigger": {
        "slot": "main",
        "action": "open-overlay"
      },
      "prototypeSelector": "#overlay-pipeline-rerun",
      "reactComponent": "PlatformPipelineRerunSheet",
      "closeBehavior": [
        "escape",
        "outside-click",
        "primary-action"
      ]
    },
    {
      "id": "platform.alert-handle",
      "kind": "sheet",
      "blocking": false,
      "requiredInDefaultFlow": true,
      "trigger": {
        "slot": "main",
        "action": "open-overlay"
      },
      "prototypeSelector": "#overlay-alert-handle",
      "reactComponent": "PlatformAlertHandleSheet",
      "closeBehavior": [
        "escape",
        "outside-click",
        "primary-action"
      ]
    },
    {
      "id": "platform.task-detail",
      "kind": "drawer",
      "blocking": false,
      "requiredInDefaultFlow": true,
      "trigger": {
        "slot": "main",
        "action": "open-overlay"
      },
      "prototypeSelector": "#overlay-task-detail",
      "reactComponent": "PlatformTaskDetailDrawer",
      "closeBehavior": [
        "escape",
        "outside-click",
        "primary-action"
      ]
    }
  ]
}
