{
  "id": "strategy-list",
  "version": 2,
  "status": "contract-ready",
  "createdAt": "2026-04-27",
  "updatedAt": "2026-08-29",
  "route": "/research/strategies",
  "pagePattern": "catalog-screener",
  "shellFamily": "catalog",
  "prototypeRef": "docs/designs/specs/prototypes/page-strategy-list.html",
  "landing": {
    "reactRouteStatus": "implemented",
    "featureModule": "src/features/strategy",
    "contractStatus": "verified",
    "overlayStatus": "triggerable",
    "prototypeVerified": true,
    "reactParityVerified": true,
    "reactTestRefs": [
      "src/features/strategy/components/strategy-list-page-live.test.tsx"
    ],
    "reactComponentRefs": [
      "StrategyListPage"
    ]
  },
  "liveData": {
    "readPaths": [
      "/api/v1/strategies",
      "/api/v1/strategies/{strategy_id}"
    ],
    "writePaths": [
      "/api/v1/strategies"
    ],
    "mockFallback": false
  },
  "viewports": [
    {
      "width": 1536,
      "height": 900,
      "role": "primary"
    },
    {
      "width": 1366,
      "height": 768,
      "role": "compact"
    },
    {
      "width": 1200,
      "height": 800,
      "role": "compact"
    }
  ],
  "slots": [
    {
      "name": "toolbar",
      "required": true,
      "infoLevel": "l1",
      "prototypeSelector": "[data-contract-slot='header']",
      "reactSelector": "[data-testid='strategy-catalog-filters']",
      "layoutStrategy": "content-driven",
      "threshold": {
        "x": 4,
        "y": 4,
        "widthRatio": 0.03,
        "heightRatio": 0.05
      },
      "a11yRole": "region",
      "responsiveBehavior": {
        "compact": "collapsed"
      }
    },
    {
      "name": "main",
      "required": true,
      "infoLevel": "l1",
      "prototypeSelector": "[data-contract-slot='main']",
      "reactSelector": "[data-testid='strategy-catalog-main']",
      "layoutStrategy": "content-driven",
      "threshold": {
        "x": 4,
        "y": 4,
        "widthRatio": 0.03,
        "heightRatio": 0.05
      },
      "a11yRole": "main"
    },
    {
      "name": "detail",
      "required": true,
      "infoLevel": "l2",
      "prototypeSelector": "[data-contract-slot='detail']",
      "reactSelector": "[data-testid='strategy-catalog-detail']",
      "layoutStrategy": "fixed-width",
      "threshold": {
        "x": 4,
        "y": 4,
        "widthRatio": 0.03,
        "heightRatio": 0.05
      },
      "a11yRole": "complementary",
      "responsiveBehavior": {
        "compact": "overlay"
      }
    }
  ],
  "subSlots": [
    {
      "name": "governance-summary",
      "parentSlot": "toolbar",
      "infoLevel": "l1",
      "prototypeSelector": ".perf-summary",
      "reactSelector": "[data-testid='strategy-catalog-summary']",
      "threshold": {
        "widthRatio": 0.05,
        "heightRatio": 0.05
      }
    }
  ],
  "states": {
    "universal": [
      "loading",
      "empty",
      "error",
      "stale"
    ],
    "pageSpecific": [
      "selected-strategy",
      "filter-empty",
      "performance-evidence-missing",
      "new-draft-open",
      "clone-draft-open",
      "deprecation-governance-open"
    ]
  },
  "interactions": [
    {
      "id": "filter-strategy-catalog",
      "trigger": "search-or-lifecycle-filter",
      "affectedSlots": [
        "toolbar",
        "main",
        "detail"
      ],
      "expectedBehavior": "filters only server-provided strategy metadata and never falls back to prototype rows"
    },
    {
      "id": "select-strategy",
      "trigger": "strategy-id-button",
      "affectedSlots": [
        "main",
        "detail"
      ],
      "expectedBehavior": "shows the selected immutable version identity and keeps unbound performance evidence explicit"
    },
    {
      "id": "create-strategy-draft",
      "trigger": "new-strategy-action",
      "affectedSlots": [
        "main",
        "detail"
      ],
      "expectedBehavior": "creates a draft through the typed strategy endpoint with an idempotency key and hands off to Strategy Studio"
    },
    {
      "id": "clone-strategy-draft",
      "trigger": "clone-row-action",
      "affectedSlots": [
        "main",
        "detail"
      ],
      "expectedBehavior": "reads the source server spec and creates an independent draft without copying fabricated metrics"
    },
    {
      "id": "govern-strategy-deprecation",
      "trigger": "deprecate-row-action",
      "affectedSlots": [
        "main",
        "detail"
      ],
      "expectedBehavior": "routes destructive intent to append-only version governance and never issues an unsupported DELETE"
    }
  ],
  "flags": {
    "hasStatusBar": false,
    "sidebarCollapsible": false
  },
  "metrics": {
    "capturedAt": "2026-08-29",
    "viewport": "1536x900",
    "baseline": {
      "toolbar": {
        "width": 1480,
        "height": 48,
        "strategy": "content-driven"
      },
      "main": {
        "width": 1160,
        "height": 716,
        "strategy": "content-driven"
      },
      "detail": {
        "width": 320,
        "height": 764,
        "strategy": "fixed-width"
      }
    }
  },
  "visualThresholds": {
    "consoleErrors": 0,
    "pageErrors": 0,
    "missingSelectors": 0,
    "targetMismatch": 0,
    "pixelDiffRatio": 0.055
  },
  "overlays": [
    {
      "id": "strategy-list.strategy-clone",
      "kind": "sheet",
      "blocking": false,
      "requiredInDefaultFlow": true,
      "trigger": {
        "slot": "main",
        "action": "open-overlay"
      },
      "prototypeSelector": "#overlay-strategy-clone",
      "reactComponent": "StrategyListOverlays",
      "closeBehavior": [
        "escape",
        "outside-click",
        "primary-action"
      ]
    },
    {
      "id": "strategy-list.strategy-delete",
      "kind": "modal",
      "blocking": true,
      "requiredInDefaultFlow": true,
      "trigger": {
        "slot": "main",
        "action": "open-overlay"
      },
      "prototypeSelector": "#overlay-strategy-delete",
      "reactComponent": "StrategyListOverlays",
      "closeBehavior": [
        "escape",
        "outside-click",
        "primary-action"
      ]
    }
  ]
}
