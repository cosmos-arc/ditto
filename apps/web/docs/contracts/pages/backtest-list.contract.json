{
  "id": "backtest-list",
  "version": 3,
  "status": "contract-ready",
  "createdAt": "2026-04-27",
  "updatedAt": "2026-08-30",
  "route": "/research/backtests",
  "pagePattern": "catalog-screener",
  "shellFamily": "catalog",
  "prototypeRef": "docs/designs/specs/prototypes/page-backtest-list.html",
  "landing": {
    "reactRouteStatus": "implemented",
    "featureModule": "src/features/backtest",
    "contractStatus": "verified",
    "overlayStatus": "triggerable",
    "prototypeVerified": true,
    "reactParityVerified": true,
    "reactTestRefs": [
      "src/features/backtest/components/backtest-list-page.test.tsx",
      "src/features/backtest/components/backtest-components.test.tsx"
    ],
    "reactComponentRefs": ["BacktestListPage"]
  },
  "liveData": {
    "readPaths": ["/api/v1/backtests/runs"],
    "writePaths": [],
    "mockFallback": false
  },
  "viewports": [
    { "width": 1536, "height": 900, "role": "primary" },
    { "width": 1366, "height": 768, "role": "compact" },
    { "width": 1200, "height": 800, "role": "compact" }
  ],
  "slots": [
    {
      "name": "toolbar",
      "required": true,
      "infoLevel": "l1",
      "prototypeSelector": ".filter-toolbar",
      "reactSelector": "[data-slot='toolbar']",
      "layoutStrategy": "content-driven",
      "threshold": { "x": 6, "y": 44, "widthRatio": 0.03, "heightRatio": 0.55 },
      "a11yRole": "toolbar",
      "responsiveBehavior": { "compact": "reflow" }
    },
    {
      "name": "main",
      "required": true,
      "infoLevel": "l1",
      "prototypeSelector": ".catalog-table",
      "reactSelector": "[data-slot='main']",
      "layoutStrategy": "flex",
      "threshold": { "x": 10, "y": 22, "widthRatio": 0.08, "heightRatio": 0.12 },
      "a11yRole": "main"
    },
    {
      "name": "detail",
      "required": true,
      "infoLevel": "l2",
      "prototypeSelector": ".catalog-detail",
      "reactSelector": "[data-slot='detail']",
      "layoutStrategy": "fixed-width",
      "threshold": { "x": 22, "y": 60, "widthRatio": 0.2, "heightRatio": 0.16 },
      "a11yRole": "complementary",
      "responsiveBehavior": { "compact": "unchanged" }
    }
  ],
  "states": {
    "universal": ["loading", "empty", "error", "stale"],
    "pageSpecific": [
      "selected-backtest",
      "filtered-results",
      "filtered-empty",
      "run-queued",
      "run-running",
      "run-completed",
      "run-failed",
      "benchmark-unpublished"
    ]
  },
  "interactions": [
    {
      "id": "filter-backtest-runs",
      "trigger": "search-or-status-filter",
      "affectedSlots": ["toolbar", "main", "detail"],
      "expectedBehavior": "filters only live run summaries and keeps selection aligned with the visible result set"
    },
    {
      "id": "select-backtest-run",
      "trigger": "run-row",
      "affectedSlots": ["main", "detail"],
      "expectedBehavior": "shows the exact run, strategy version, lifecycle state, progress, step, dates, benchmark publication, and failure message"
    },
    {
      "id": "open-backtest-result",
      "trigger": "result-action",
      "affectedSlots": ["detail"],
      "expectedBehavior": "opens the result workbench for the selected run identity without synthesizing report or NAV evidence in the catalog"
    },
    {
      "id": "retry-backtest-catalog",
      "trigger": "typed-retry-action",
      "affectedSlots": ["main", "detail"],
      "expectedBehavior": "retries the generated runs endpoint while withholding the retired static catalog"
    }
  ],
  "flags": { "hasStatusBar": false, "sidebarCollapsible": false },
  "metrics": {
    "capturedAt": "2026-08-30",
    "viewport": "1536x900",
    "baseline": {
      "toolbar": { "width": 1480, "height": 48, "strategy": "content-driven" },
      "main": { "width": 1160, "height": 720, "strategy": "flex" },
      "detail": { "width": 320, "height": 720, "strategy": "fixed-width" }
    }
  },
  "visualThresholds": {
    "consoleErrors": 0,
    "pageErrors": 0,
    "missingSelectors": 0,
    "targetMismatch": 0,
    "pixelDiffRatio": 0.075
  },
  "overlays": [
    {
      "id": "backtest-list.backtest-compare",
      "kind": "drawer",
      "blocking": false,
      "requiredInDefaultFlow": true,
      "trigger": { "slot": "toolbar", "action": "open-overlay" },
      "prototypeSelector": "#overlay-backtest-compare",
      "reactComponent": "BacktestCompareOverlay",
      "closeBehavior": ["escape", "outside-click", "primary-action"]
    }
  ]
}
