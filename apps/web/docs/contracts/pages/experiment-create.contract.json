  "states": {
    "universal": ["loading", "empty", "error", "stale"],
    "pageSpecific": [
      "invalid-json",
      "preflight-not-run",
      "preflight-ready",
      "preflight-blocked",
      "preflight-stale",
      "confirmation-required",
      "launch-pending",
      "launch-rejected",
      "launch-outcome-unknown"
    ]
  },
  "interactions": [
    {
      "id": "edit-planning-draft",
      "trigger": "planning-form-edit",
      "affectedSlots": ["source", "main", "inspector", "logs"],
      "expectedBehavior": "updates the exact planning draft and invalidates any previous preflight confirmation"
    },
    {
      "id": "run-read-only-preflight",
      "trigger": "preflight-action",
      "affectedSlots": ["header", "inspector", "logs"],
      "expectedBehavior": "submits the exact planning document for read-only validation without creating an experiment"
    },
    {
      "id": "confirm-plan-hash",
      "trigger": "plan-hash-checkbox",
      "affectedSlots": ["header", "inspector", "logs"],
      "expectedBehavior": "enables launch only for the current ready preflight plan hash"
    },
    {
      "id": "launch-experiment",
      "trigger": "launch-action",
      "affectedSlots": ["header", "inspector", "logs"],
      "expectedBehavior": "launches with the confirmed plan hash and reuses the same idempotency key when the outcome is unknown"
    },
    {
      "id": "request-governance-assistance",
      "trigger": "agent-context-action",
      "affectedSlots": ["source"],
      "expectedBehavior": "hands the exact serialized planning identity to the governance Agent workspace"
    }
  ],
