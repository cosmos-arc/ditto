{
  "id": "experiment-detail",
  "version": 1,
  "status": "draft",
  "createdAt": "2026-08-01",
  "updatedAt": "2026-08-01",
  "route": "/research/experiments/$id",
  "pagePattern": "object-hub",
  "shellFamily": "object-hub",
  "prototypeRef": "docs/contracts/pages/experiment-detail.contract.json",
  "landing": {
    "reactRouteStatus": "implemented",
    "featureModule": "src/features/research",
    "contractStatus": "generated",
    "overlayStatus": "none",
    "visualAuditStatus": "queued",
    "reactTestRefs": [
      "src/features/research/components/experiment-detail-page.test.tsx",
      "src/features/research/components/candidate-selection-holdout.test.tsx"
    ],
    "reactComponentRefs": [
      "ExperimentDetailPage"
    ]
  },
  "viewports": [
    { "width": 1536, "height": 900, "role": "primary" },
    { "width": 900, "height": 768, "role": "compact" }
  ],
  "slots": [
    {
      "name": "meta",
      "required": true,
      "prototypeSelector": ".filter-toolbar",
      "reactSelector": "[data-contract-slot='experiment-meta']",
      "a11yRole": "banner",
      "responsiveBehavior": { "compact": "reflow" }
    },
    {
      "name": "main",
      "required": true,
      "prototypeSelector": ".catalog-table",
      "reactSelector": "main",
      "a11yRole": "main"
    },
    {
      "name": "bottom",
      "required": true,
      "prototypeSelector": ".catalog-detail",
      "reactSelector": "[data-slot='status-bar']",
      "a11yRole": "status",
      "responsiveBehavior": { "compact": "collapsed" }
    }
  ],
  "states": {
    "universal": ["loading", "empty", "error", "stale"],
    "pageSpecific": ["running", "paused", "failed", "completed", "partial-resource-error"]
  },
  "flags": { "hasStatusBar": true, "sidebarCollapsible": false },
  "visualThresholds": {
    "consoleErrors": 0,
    "pageErrors": 0,
    "missingSelectors": 0,
    "targetMismatch": 0,
    "pixelDiffRatio": 0.02
  }
}
