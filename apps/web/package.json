{
  "name": "ditto-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run routes:generate && tsc -b && vite build",
    "preview": "vite preview",
    "check": "bun run lint && bun run type && bun run test:unit && bun run arch:check && bun run harness:check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type": "bun run routes:generate && tsc -b",
    "test": "vitest",
    "test:run": "bun run test:unit",
    "test:unit": "vitest run src .agents/skills",
    "test:prototype": "vitest run scripts --exclude 'scripts/agent_harness/**'",
    "test:coverage": "bun run routes:generate && vitest run src --coverage",
    "ci": "bun run check && bun run test:coverage && bun run test:prototype && bun run build",
    "routes:generate": "bun scripts/generate-route-tree.mjs",
    "arch:check": "bun scripts/agent_harness/arch-check.mjs",
    "harness:sync": "bun scripts/agent_harness/sync-skills.mjs",
    "harness:sync:check": "bun scripts/agent_harness/sync-skills.mjs --check",
    "harness:validate": "bun scripts/agent_harness/validate.mjs",
    "harness:test": "bun test scripts/agent_harness/tests",
    "harness:check": "bun run harness:sync:check && bun run harness:validate && bun run harness:test",
    "check:changed": "bun scripts/agent_harness/hook.mjs --event check-changed",
    "gen:api": "bash scripts/gen-api.sh",
    "visual:audit": "bun .agents/skills/ditto-app-dev/scripts/visual-audit.mjs --route /trading --react-base http://127.0.0.1:5173 --prototype-base http://127.0.0.1:8888/docs/designs/specs/prototypes",
    "visual:audit:cli": "bun .agents/skills/ditto-app-dev/scripts/visual-audit.mjs",
    "acceptance:r1-trading": "bun scripts/r1-trading-acceptance.ts",
    "acceptance:r3-research": "bun scripts/r3-research-acceptance.ts",
    "prototype:gates": "bun scripts/run-prototype-gates.ts",
    "prototype:interaction": "vitest run scripts/prototype-interaction-ux-contract.test.ts",
    "prototype:visual-matrix": "bun scripts/prototype-visual-matrix.ts",
    "audit:routes": "bun scripts/audit-route-coverage.mjs",
    "audit:tokens": "bun scripts/audit-wcag-contrast.mjs && bun scripts/audit-token-dead-links.mjs",
    "audit:tokens:contrast": "bun scripts/audit-wcag-contrast.mjs",
    "audit:tokens:dead-links": "bun scripts/audit-token-dead-links.mjs",
    "build:tokens": "bun scripts/export-tokens.ts",
    "build:tokens:check": "bun scripts/export-tokens.ts --check",
    "audit:tokens:diff": "bun scripts/audit-token-diff.mjs",
    "generate-contracts": "bun .agents/skills/ditto-page-contract/scripts/generate.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-router": "^1.168.4",
    "ag-grid-community": "^35.2.1",
    "ag-grid-react": "^35.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-plugin": "^1.167.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.2",
    "ajv": "^8.18.0",
    "culori": "^4.0.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "msw": "^2.12.14",
    "openapi-typescript": "^7.13.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "style-dictionary": "^5.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.2",
    "vitest": "4.1.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
