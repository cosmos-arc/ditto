{
  "name": "ditto-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check . && tsc --noEmit && vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "visual:audit": "bun scripts/visual-audit.mjs",
    "generate-contracts": "bun scripts/contract-generator/generate.mjs"
  },
