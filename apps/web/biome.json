{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"files": {
		"maxSize": 2097152,
		"includes": [
			"src/**",
			"scripts/**",
			"copilot-baseline.mjs",
			"final-verify.mjs",
			"index.html",
			"*.config.*",
			"tsconfig*.json",
			"biome.json"
		]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useLiteralKeys": "off",
				"useMaxParams": "warn"
			},
			"correctness": {
				"noUndeclaredDependencies": "error",
				"noUnusedVariables": "error",
				"useExhaustiveDependencies": "warn"
			},
			"style": {
				"noNonNullAssertion": "off",
				"noRestrictedGlobals": {
					"level": "error",
					"options": {
						"deniedGlobals": {
							"EventSource": "network access is restricted to src/api and tests",
							"XMLHttpRequest": "network access is restricted to src/api and tests",
							"WebSocket": "network access is restricted to src/api and tests",
							"fetch": "network access is restricted to src/api and tests"
						}
					}
				}
			},
			"suspicious": {
				"noConsole": "warn",
				"noDuplicateDependencies": "warn",
				"noEmptySource": "warn",
				"noExplicitAny": "error",
				"noImportCycles": "warn",
				"noReactForwardRef": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"css": {
		"parser": {
			"cssModules": false,
			"tailwindDirectives": true
		},
		"linter": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		}
	},
	"overrides": [
		{
			"includes": [
				"src/routeTree.gen.ts",
				"src/types/api.d.ts",
				"src/api/generated/schema.d.ts",
				"src/api/generated/operation-contracts.ts"
			],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx", "**/__tests__/**"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveCognitiveComplexity": "off",
						"useMaxParams": "off"
					},
					"suspicious": {
						"noConsole": "off",
						"noExplicitAny": "off"
					},
					"style": {
						"noRestrictedGlobals": "off"
					}
				}
			}
		},
		{
			"includes": ["src/api/**", "src/mocks/**", "src/test/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedGlobals": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.config.ts", "**/*.config.mts"],
			"linter": {
				"rules": {
					"correctness": {
						"noUndeclaredDependencies": "off"
					}
				}
			}
		},
		{
			"includes": ["scripts/**", "copilot-baseline.mjs", "final-verify.mjs"],
			"assist": {
				"actions": {
					"source": {
						"organizeImports": "off"
					}
				}
			},
			"formatter": {
				"enabled": false
			},
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off"
					},
					"style": {
						"noRestrictedGlobals": "off"
					},
					"suspicious": {
						"noAssignInExpressions": "off"
					}
				}
			}
		},
		{
			"includes": [
				"scripts/agent_harness/**",
				"scripts/generate-route-tree.mjs",
				"scripts/dependency-cruiser-typescript-loader.mjs",
				"scripts/run-dependency-cruise.mjs"
			],
			"assist": {
				"actions": {
					"source": {
						"organizeImports": "on"
					}
				}
			},
			"formatter": {
				"enabled": true
			},
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "error"
					},
					"suspicious": {
						"noAssignInExpressions": "error"
					}
				}
			}
		}
	],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
