{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.unit.tsbuildinfo",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "react", "react-dom", "vitest/globals", "@testing-library/jest-dom", "node"],
		"jsx": "react-jsx"
	},
	"include": [
		"src/types/**/*.d.ts",
		"src/**/*.test.ts",
		"src/**/*.test.tsx",
		"src/**/*.spec.ts",
		"src/**/*.spec.tsx",
		"src/test/**/*.ts",
		"src/test/**/*.tsx"
	]
}
