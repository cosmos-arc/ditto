{
	"permissions": {
		"allow": [
			"Read(**)",
			"Write(**)",
			"Edit(**)",
			"LSP(**)",
			"Skill(**)",
			"Glob(**)",
			"Grep(**)",
			"Task(**)",
			"TodoWrite(**)",
			"AskUserQuestion(**)",
			"Bash(bun *)",
			"Bash(git *)",
			"Bash(gh *)"
