{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "LSP(**)",
      "Skill(**)",
      "Glob(**)",
      "Grep(**)",
      "Task(**)",
      "TodoWrite(**)",
      "AskUserQuestion(**)",
      "Bash(bun *)",
      "Bash(git *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git * --no-verify *)"
    ]
  },
  "enabledPlugins": {},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/agent_harness/hook.mjs\" --host claude --event pre-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/agent_harness/hook.mjs\" --host claude --event post-tool",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/agent_harness/hook.mjs\" --host claude --event stop",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
