{
  "id": "universe-list",
  "version": 2,
  "status": "contract-ready",
  "createdAt": "2026-04-27",
  "updatedAt": "2026-08-30",
  "route": "/research/universes",
  "pagePattern": "catalog-screener",
  "shellFamily": "catalog",
  "prototypeRef": "prototype/page-universe-list.html",
  "landing": {
    "reactRouteStatus": "implemented",
    "featureModule": "src/features/research",
    "contractStatus": "verified",
    "overlayStatus": "triggerable",
    "prototypeVerified": true,
    "reactParityVerified": true,
    "reactTestRefs": [
      "src/features/research/components/universe-list-page.test.tsx",
      "src/features/research/components/research-components.test.tsx"
    ],
    "reactComponentRefs": ["UniverseListPage"]
  },
  "liveData": {
    "readPaths": [
      "/api/v1/universes",
      "/api/v1/universes/{universe_id}/members?asof={as_of_date}"
    ],
    "writePaths": [
      "POST /api/v1/universes",
      "PUT /api/v1/universes/{universe_id}",
      "DELETE /api/v1/universes/{universe_id}"
    ],
    "mockFallback": false
  },
  "viewports": [
    { "width": 1536, "height": 900, "role": "primary" },
    { "width": 1366, "height": 768, "role": "compact" },
    { "width": 1200, "height": 800, "role": "compact" }
  ],
  "slots": [
    {
      "name": "toolbar",
      "required": true,
      "infoLevel": "l1",
      "prototypeSelector": ".universe-kpi-strip",
      "reactSelector": "[data-slot='toolbar']",
      "layoutStrategy": "content-driven",
      "threshold": { "x": 6, "y": 6, "widthRatio": 0.03, "heightRatio": 0.08 },
      "a11yRole": "toolbar",
      "responsiveBehavior": { "compact": "reflow" }
    },
    {
      "name": "main",
      "required": true,
      "infoLevel": "l1",
      "prototypeSelector": ".catalog-table",
      "reactSelector": "[data-slot='main']",
      "layoutStrategy": "flex",
      "threshold": { "x": 10, "y": 22, "widthRatio": 0.08, "heightRatio": 0.12 },
      "a11yRole": "main"
    },
    {
      "name": "detail",
      "required": true,
      "infoLevel": "l2",
      "prototypeSelector": ".catalog-detail",
      "reactSelector": "[data-slot='detail']",
      "layoutStrategy": "fixed-width",
      "threshold": { "x": 22, "y": 60, "widthRatio": 0.2, "heightRatio": 0.16 },
      "a11yRole": "complementary",
      "responsiveBehavior": { "compact": "unchanged" }
    }
  ],
  "states": {
    "universal": ["loading", "empty", "error", "stale"],
    "pageSpecific": [
      "selected-universe",
      "filtered-results",
      "filtered-empty",
      "preset-definition",
      "custom-definition",
      "membership-asof-unbound",
      "membership-loading",
      "membership-empty",
      "membership-unavailable",
      "create-failed",
      "update-failed",
      "delete-failed"
    ]
  },
  "interactions": [
    {
      "id": "filter-universe-definitions",
      "trigger": "search-or-type-filter",
      "affectedSlots": ["toolbar", "main", "detail"],
      "expectedBehavior": "filters only generated universe definitions and keeps the selected detail aligned with visible rows"
    },
    {
      "id": "select-universe-definition",
      "trigger": "universe-row",
      "affectedSlots": ["main", "detail"],
      "expectedBehavior": "shows exact definition identity, type, source reference, description, and custom-only governance actions"
    },
    {
      "id": "bind-membership-asof",
      "trigger": "explicit-date-input",
      "affectedSlots": ["detail"],
      "expectedBehavior": "does not request members until a complete as-of date is bound, includes that date in the cache key and request, and never falls back to latest membership"
    },
    {
      "id": "create-universe-definition",
      "trigger": "create-sheet-submit",
      "affectedSlots": ["toolbar", "main", "detail"],
      "expectedBehavior": "creates one custom definition through the generated command and refreshes the same catalog tree"
    },
    {
      "id": "update-universe-definition",
      "trigger": "edit-sheet-submit",
      "affectedSlots": ["main", "detail"],
      "expectedBehavior": "updates a custom definition; member revisions require an explicit effective date and never mutate presets"
    },
    {
      "id": "delete-universe-definition",
      "trigger": "delete-confirmation",
      "affectedSlots": ["main", "detail"],
      "expectedBehavior": "permanently deletes only the selected custom definition after an explicit confirmation"
    },
    {
      "id": "retry-universe-resource",
      "trigger": "typed-retry-action",
      "affectedSlots": ["main", "detail"],
      "expectedBehavior": "retries the failed catalog or membership resource without rendering retired static definitions or unscoped members"
    }
  ],
  "flags": { "hasStatusBar": false, "sidebarCollapsible": false },
  "metrics": {
    "capturedAt": "2026-08-30",
    "viewport": "1536x900",
    "baseline": {
      "toolbar": { "width": 1480, "height": 42, "strategy": "content-driven" },
      "main": { "width": 1160, "height": 790, "strategy": "flex" },
      "detail": { "width": 320, "height": 790, "strategy": "fixed-width" }
    }
  },
  "visualThresholds": {
    "consoleErrors": 0,
    "pageErrors": 0,
    "missingSelectors": 0,
    "targetMismatch": 0,
    "pixelDiffRatio": 0.075
  },
  "overlays": [
    {
      "id": "universe-list.universe-edit",
      "kind": "sheet",
      "blocking": false,
      "requiredInDefaultFlow": true,
      "trigger": { "slot": "detail", "action": "open-overlay" },
      "prototypeSelector": "#overlay-universe-edit",
      "reactComponent": "CreateUniverseSheet|EditUniverseSheet",
      "closeBehavior": ["escape", "outside-click", "primary-action"]
    },
    {
      "id": "universe-list.universe-delete",
      "kind": "modal",
      "blocking": true,
      "requiredInDefaultFlow": true,
      "trigger": { "slot": "detail", "action": "open-overlay" },
      "prototypeSelector": "#overlay-universe-delete",
      "reactComponent": "DeleteUniverseDialog",
      "closeBehavior": ["escape", "outside-click", "primary-action"]
    }
  ]
}
