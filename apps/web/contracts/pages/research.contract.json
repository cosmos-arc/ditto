  "interactions": [
    {
      "id": "create-research-artifact",
      "trigger": "header-create-action",
      "affectedSlots": [
        "main"
      ],
      "expectedBehavior": "opens the matching backtest, strategy or experiment sheet without creating server state"
    },
    {
      "id": "inspect-run",
      "trigger": "recent-run-row",
      "affectedSlots": [
        "activity",
        "main"
      ],
      "expectedBehavior": "opens a read-only run drawer linked to the persisted experiment detail"
    },
    {
      "id": "inspect-review",
      "trigger": "review-queue-row",
      "affectedSlots": [
        "activity",
        "main"
      ],
      "expectedBehavior": "opens a read-only review handoff and never treats a missing review packet as approved"
    },
    {
      "id": "switch-analysis",
      "trigger": "analysis-tab",
      "affectedSlots": [
        "analysis"
      ],
      "expectedBehavior": "switches the local analysis dimension while preserving the factor catalog and evidence scope"
    }
  ],
