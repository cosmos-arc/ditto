  "interactions": [
    {
      "id": "select-bars-date-range",
      "trigger": "date-input-change",
      "affectedSlots": [
        "main"
      ],
      "expectedBehavior": "requeries non-experimental unadjusted bars for one positive numeric instrument id and keeps missing snapshot identity visible"
    },
    {
      "id": "select-bars-period",
      "trigger": "segmented-button-press",
      "affectedSlots": [
        "main"
      ],
      "expectedBehavior": "resamples fetched daily candles to weekly or monthly buckets locally without refetching and keeps gaps uninterpolated"
    },
    {
      "id": "select-bars-adjustment",
      "trigger": "segmented-button-press",
      "affectedSlots": [
        "main"
      ],
      "expectedBehavior": "requeries bars with none/qfq/hfq adjustment; ETF disables the switch because server-side ETF adjustment is not wired"
    },
    {
      "id": "toggle-experimental-data",
      "trigger": "checkbox-change",
      "affectedSlots": [
        "main"
      ],
      "expectedBehavior": "explicitly opts the bars query into experimental dataset maturity for research browsing; default stays fail-closed off"
    },
    {
      "id": "toggle-indicator-overlays",
      "trigger": "checkbox-change",
      "affectedSlots": [
        "main"
      ],
      "expectedBehavior": "toggles MA(5/20/60)/Donchian/MACD/RSI/ATR overlays computed by the technical-analysis registry on daily bars; selection persists in localStorage and weekly/monthly periods disable overlays honestly"
    },
    {
      "id": "toggle-etf-nav-overlay",
      "trigger": "checkbox-change",
      "affectedSlots": [
        "main"
      ],
      "expectedBehavior": "overlays the ETF NAV line when local nav data exists and shows an explicit unavailable state when it does not"
    },
    {
      "id": "receive-trade-drill",
      "trigger": "search-param-jump",
      "affectedSlots": [
        "main"
      ],
      "expectedBehavior": "focuses the chart on the drilled trade date with a direction marker and the source run's as_of watermark preserved from the backtest jump context"
    }
  ]
