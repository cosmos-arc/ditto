  "overlays": [
    {
      "id": "factor-list.factor-compare",
      "kind": "drawer",
      "blocking": false,
      "requiredInDefaultFlow": true,
      "trigger": {
        "slot": "main",
        "action": "open-overlay"
      },
      "prototypeSelector": "#overlay-factor-compare",
      "reactComponent": "FactorCompareDrawer",
      "closeBehavior": [
        "escape",
        "outside-click",
        "primary-action"
      ]
    }
  ]
