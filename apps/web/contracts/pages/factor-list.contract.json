    "reactParityVerified": true,
    "reactTestRefs": [
      "src/features/research/components/research-components.test.tsx",
      "src/features/research/components/factor-list-page-live.test.tsx"
    ],
    "reactComponentRefs": [
      "FactorListPage"
    ]
  },
  "liveData": {
    "readPaths": [
      "/api/v1/research/factors"
    ],
    "writePaths": [],
    "mockFallback": false
  },
  "viewports": [
    {
      "width": 1536,
      "height": 900,
      "role": "primary"
    },
    {
      "width": 1366,
      "height": 768,
      "role": "compact"
    },
    {
      "width": 1200,
      "height": 800,
      "role": "compact"
    }
  ],
  "slots": [
    {
      "name": "toolbar",
      "required": true,
      "infoLevel": "l1",
      "prototypeSelector": ".filter-toolbar",
      "reactSelector": "[data-testid='factor-catalog-filters']",
      "layoutStrategy": "content-driven",
      "threshold": {
        "x": 4,
        "y": 4,
        "widthRatio": 0.03,
        "heightRatio": 0.05
      },
      "a11yRole": "region",
      "responsiveBehavior": {
        "compact": "collapsed"
      }
    },
    {
      "name": "main",
      "required": true,
      "infoLevel": "l1",
      "prototypeSelector": "[data-contract-slot='main']",
      "reactSelector": "[data-slot='main']",
      "layoutStrategy": "content-driven",
      "threshold": {
        "x": 4,
        "y": 4,
        "widthRatio": 0.03,
        "heightRatio": 0.05
      },
      "a11yRole": "main"
    },
    {
      "name": "detail",
      "required": true,
      "infoLevel": "l2",
      "prototypeSelector": "[data-contract-slot='detail']",
      "reactSelector": "[data-testid='factor-catalog-detail']",
      "layoutStrategy": "fixed-width",
      "threshold": {
        "x": 4,
        "y": 4,
        "widthRatio": 0.03,
        "heightRatio": 0.05
      },
      "a11yRole": "complementary",
      "responsiveBehavior": {
        "compact": "overlay"
      }
    }
  ],
  "states": {
    "universal": [
      "loading",
      "empty",
      "error",
      "stale"
    ],
    "pageSpecific": [
      "selected-factor",
      "filter-empty",
      "evidence-scope-missing",
      "factor-compare-open"
    ]
  },
  "interactions": [
    {
      "id": "filter-factor-catalog",
      "trigger": "search-or-lane-filter",
      "affectedSlots": [
        "toolbar",
        "main",
        "detail"
      ],
      "expectedBehavior": "filters only the governed factor catalog and never falls back to prototype rows"
    },
    {
      "id": "select-factor",
      "trigger": "factor-id-button",
      "affectedSlots": [
        "main",
        "detail"
      ],
      "expectedBehavior": "shows descriptor and available preview while keeping missing diagnostic scope explicit"
    },
    {
      "id": "compare-factors",
      "trigger": "factor-compare-action",
      "affectedSlots": [
        "main",
        "detail"
      ],
      "expectedBehavior": "opens a two-factor catalog comparison and does not invent correlation evidence"
    }
  ],
  "flags": {
    "hasStatusBar": false,
    "sidebarCollapsible": false
  },
  "metrics": {
    "capturedAt": "2026-08-29",
    "viewport": "1536x900",
    "baseline": {
