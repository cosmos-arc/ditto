      "expectedBehavior": "sidebar width changes and main area expands"
    },
    {
      "id": "signal-evidence",
      "trigger": "priority-item-detail",
      "affectedSlots": [
        "main"
      ],
      "expectedBehavior": "opens read-only signal evidence and requires an explicit handoff before trading review"
    },
    {
      "id": "workspace-settings",
      "trigger": "workspace-settings-button",
      "affectedSlots": [
        "sidebar",
        "main"
      ],
      "expectedBehavior": "opens persisted UI preferences and changes only implemented settings"
    },
    {
      "id": "decision-evidence",
      "trigger": "decision-evidence-button",
      "affectedSlots": [
        "main"
      ],
      "expectedBehavior": "opens a read-only Daily Decision V3 evidence summary without invoking a model"
    }
