    "reactParityVerified": true,
    "reactTestRefs": [
      "src/features/research/components/experiment-detail-page.test.tsx",
      "src/features/research/components/candidate-selection-holdout.test.tsx",
      "src/features/research/components/experiment-run-recovery.test.tsx",
      "src/features/research/components/experiment-validation-view.test.tsx"
    ],
    "reactComponentRefs": ["ExperimentDetailPage"]
  },
  "liveData": {
    "readPaths": [
      "/api/v1/research/experiments/{experiment_id}",
      "/api/v1/research/experiments/{experiment_id}/candidates",
      "/api/v1/research/experiments/{experiment_id}/gates",
      "/api/v1/research/experiments/{experiment_id}/comparison",
      "/api/v1/research/experiments/{experiment_id}/artifacts",
      "/api/v1/research/experiments/{experiment_id}/selection-evidence",
      "/api/v1/research/candidates/{candidate_id}/{resource_kind}"
    ],
    "writePaths": [
      "/api/v1/research/experiments/{experiment_id}/{control_action}",
      "/api/v1/research/experiments/{experiment_id}/retry-fold",
      "/api/v1/research/experiments/{experiment_id}/candidate-selection",
      "/api/v1/research/experiments/{experiment_id}/holdout-evaluations"
    ],
    "mockFallback": false
  },
  "viewports": [
    { "width": 1536, "height": 900, "role": "primary" },
    { "width": 1366, "height": 768, "role": "compact" },
    { "width": 1200, "height": 800, "role": "compact" }
  ],
  "slots": [
    {
      "name": "header",
      "required": true,
      "infoLevel": "l0",
      "prototypeSelector": ".shell-header",
      "reactSelector": "[data-slot='header']",
      "layoutStrategy": "content-driven",
      "threshold": { "x": 4, "y": 4, "widthRatio": 0.03, "heightRatio": 0.11 },
      "a11yRole": "banner"
    },
    {
      "name": "meta",
      "required": true,
      "infoLevel": "l1",
      "prototypeSelector": ".hub-meta",
      "reactSelector": "[data-testid='experiment-detail-meta']",
      "layoutStrategy": "content-driven",
      "threshold": { "x": 4, "y": 8, "widthRatio": 0.03, "heightRatio": 0.03 },
      "a11yRole": "complementary",
      "responsiveBehavior": { "compact": "reflow" }
    },
    {
      "name": "tabs",
      "required": true,
      "infoLevel": "l1",
      "prototypeSelector": ".hub-tabs",
      "reactSelector": "[data-testid='experiment-detail-tabs']",
      "layoutStrategy": "content-driven",
      "threshold": { "x": 4, "y": 8, "widthRatio": 0.03, "heightRatio": 0.03 },
      "a11yRole": "navigation",
      "responsiveBehavior": { "compact": "reflow" }
    },
    {
      "name": "main",
      "required": true,
      "infoLevel": "l1",
      "prototypeSelector": "[data-contract-slot='main']",
      "reactSelector": "[data-slot='main']",
      "layoutStrategy": "content-driven",
      "threshold": { "x": 4, "y": 8, "widthRatio": 0.03, "heightRatio": 0.03 },
      "a11yRole": "main"
    },
    {
      "name": "bottom",
      "required": true,
      "infoLevel": "l2",
      "prototypeSelector": ".hub-bottom",
      "reactSelector": "[data-testid='experiment-detail-bottom']",
      "layoutStrategy": "content-driven",
      "threshold": { "x": 4, "y": 4, "widthRatio": 0.03, "heightRatio": 0.03 },
      "a11yRole": "region",
      "responsiveBehavior": { "compact": "collapsed" }
    }
  ],
  "states": {
    "universal": ["loading", "empty", "error", "stale"],
    "pageSpecific": [
      "selected-candidates-tab",
      "selected-validation-tab",
      "selected-evidence-tab",
      "selected-candidate-evidence-tab",
      "detail-unavailable",
      "partial-resource-error",
      "selection-evidence-publishing",
      "candidate-evidence-stale",
      "holdout-consumed",
      "control-outcome-unknown"
    ]
  },
  "interactions": [
    {
      "id": "switch-experiment-workbench-view",
      "trigger": "tab-change",
      "affectedSlots": ["tabs", "main"],
      "expectedBehavior": "switches among already requested server resources without replacing the experiment revision identity"
    },
    {
      "id": "inspect-candidate-evidence",
      "trigger": "candidate-evidence-action",
      "affectedSlots": ["tabs", "main"],
      "expectedBehavior": "opens paginated evidence scoped to the exact experiment and candidate bundle identity"
    },
    {
      "id": "select-promotion-candidate",
      "trigger": "candidate-selection-action",
      "affectedSlots": ["main", "bottom"],
      "expectedBehavior": "requires current aggregate evidence, comparison revision, an eligible pinned candidate, and an explicit rationale"
    },
    {
      "id": "claim-holdout-evaluation",
      "trigger": "holdout-action",
      "affectedSlots": ["main", "bottom"],
      "expectedBehavior": "claims the one-time holdout only for the server selection receipt and fails closed after consumption"
    },
    {
      "id": "control-experiment-run",
      "trigger": "pause-resume-cancel-or-retry-action",
      "affectedSlots": ["header", "meta", "main"],
      "expectedBehavior": "sends the latest expected revision with an idempotency key and recovers from server truth"
    },
    {
      "id": "retry-experiment-detail",
      "trigger": "detail-retry-action",
      "affectedSlots": ["meta", "tabs", "main", "bottom"],
      "expectedBehavior": "retries the typed detail request while withholding all synthetic workbench data"
    }
  ],
  "flags": { "hasStatusBar": false, "sidebarCollapsible": false },
  "metrics": {
    "capturedAt": "2026-08-29",
    "viewport": "1536x900",
    "baseline": {
