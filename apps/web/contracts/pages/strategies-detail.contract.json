  "interactions": [
    {
      "id": "edit-strategy",
      "trigger": "edit-strategy-action",
      "affectedSlots": [
        "meta",
        "main"
      ],
      "expectedBehavior": "opens Strategy Studio for the exact strategy identity"
    },
    {
      "id": "plan-strategy-backtest",
      "trigger": "submit-backtest-action",
      "affectedSlots": [
        "meta",
        "main"
      ],
      "expectedBehavior": "hands the exact strategy id and version to experiment planning without directly creating a run"
    },
    {
      "id": "copy-strategy-draft",
      "trigger": "copy-strategy-action",
      "affectedSlots": [
        "meta",
        "main"
      ],
      "expectedBehavior": "reads the source server definition and creates an independent draft with an idempotency key"
    },
    {
      "id": "deprecate-strategy-version",
      "trigger": "deprecate-strategy-action",
      "affectedSlots": [
        "meta",
        "main"
      ],
      "expectedBehavior": "records actor and reason through the append-only deprecate command and preserves history"
    },
    {
      "id": "govern-strategy-rollback",
      "trigger": "rollback-strategy-action",
      "affectedSlots": [
        "tabs",
        "main",
        "bottom"
      ],
      "expectedBehavior": "opens version governance; reactivation requires a current pointer revision and exact confirmation"
    }
  ],
