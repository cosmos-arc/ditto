      "layoutStrategy": "fixed-width",
      "threshold": {
        "x": 8,
        "y": 52,
        "widthRatio": 0.03,
        "heightRatio": 0.12
      },
      "a11yRole": "complementary",
      "responsiveBehavior": {
        "compact": "collapsed"
      }
    }
  ],
  "states": {
    "universal": [
      "loading",
      "empty",
      "error",
      "stale"
    ],
    "pageSpecific": [
      "evidence-scope-missing",
      "diagnostics-ready",
      "handoff-open",
      "ai-governance-open",
      "diagnostic-detail-open"
    ]
  },
  "interactions": [
    {
      "id": "bind-diagnostics-scope",
      "trigger": "scope-form-submit",
      "affectedSlots": [
        "meta",
        "main",
        "sidebar"
      ],
      "expectedBehavior": "reads diagnostics only after snapshot, date window, and registry hash are all explicit"
    },
    {
      "id": "handoff-factor-to-backtest",
      "trigger": "add-backtest-action",
      "affectedSlots": [
        "main"
      ],
      "expectedBehavior": "opens a contextual handoff and does not claim a backtest was created"
    },
    {
      "id": "handoff-factor-to-experiment",
      "trigger": "add-experiment-action",
      "affectedSlots": [
        "main"
      ],
      "expectedBehavior": "opens a contextual handoff and does not write research state"
    },
    {
      "id": "request-governed-ai-analysis",
      "trigger": "ai-analysis-action",
      "affectedSlots": [
        "main",
        "sidebar"
      ],
      "expectedBehavior": "requires an immutable diagnostics identity and never invents an unsupported conclusion"
    },
    {
      "id": "inspect-diagnostics-artifact",
      "trigger": "diagnostic-detail-action",
      "affectedSlots": [
        "main",
        "sidebar"
      ],
      "expectedBehavior": "reuses the exact server-backed diagnostics query and immutable provenance"
    }
  ],
