# 日志配置
DITTO_OTEL_LOG_LEVEL=WARNING
DITTO_OTEL_LOG_FORMAT=console
DITTO_OTEL_LOG_TO_CONSOLE=true
DITTO_OTEL_LOG_TO_FILE=false

# Tracing 配置
DITTO_OTEL_TRACING_ENABLED=false
DITTO_OTEL_TRACING_EXPORTER=otlp
DITTO_OTEL_TRACING_SAMPLE_RATE=1.0

# Metrics 配置
DITTO_OTEL_METRICS_ENABLED=false
DITTO_OTEL_METRICS_EXPORTER=victoriametrics
DITTO_OTEL_VM_ENDPOINT=http://localhost:8428/opentelemetry/v1/metrics
