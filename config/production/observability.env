# 日志配置
DITTO_OTEL_LOG_LEVEL=INFO
DITTO_OTEL_LOG_FORMAT=json
DITTO_OTEL_LOG_TO_CONSOLE=true
DITTO_OTEL_LOG_TO_FILE=true

# Tracing 配置
DITTO_OTEL_TRACING_ENABLED=true
DITTO_OTEL_TRACING_EXPORTER=otlp
DITTO_OTEL_TRACING_SAMPLE_RATE=0.1

# Metrics 配置
DITTO_OTEL_METRICS_ENABLED=true
DITTO_OTEL_METRICS_EXPORTER=victoriametrics
DITTO_OTEL_VM_ENDPOINT=http://victoriametrics:8428/opentelemetry/v1/metrics
