# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_CONSOLE=true
LOG_TO_FILE=true

# Tracing 配置
TRACING_ENABLED=true
TRACING_EXPORTER=otlp
TRACING_SAMPLE_RATE=0.1

# Metrics 配置
METRICS_ENABLED=true
METRICS_EXPORTER=otlp
VM_ENDPOINT=http://victoriametrics:8428/opentelemetry/v1/metrics

# CORS 配置（仅 production 生效，通过环境变量 CORS_ORIGINS 传入，逗号分隔）
# 未设置时默认允许所有来源 (*)
# 示例: CORS_ORIGINS=https://app.ditto.example.com,https://admin.ditto.example.com
