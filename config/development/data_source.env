# 数据源配置 - Development

# Tushare API Token
# 安全警告: 不应在此文件中存储明文token！
# 请使用以下方式之一：
# 1. 环境变量: export TUSHARE_TOKEN=your_token
# 2. Keyring: python -c "import keyring; keyring.set_password('tushare', 'token', 'your_token')"
TUSHARE_TOKEN=

# FRED API Key (美国宏观数据)
# 获取 API Key: https://fred.stlouisfed.org/docs/api/api_key.html
# 安全警告: 不应在此文件中存储明文key！
# 请使用以下方式之一：
# 1. 环境变量: export FRED_API_KEY=your_api_key
# 2. Keyring: python -c "import keyring; keyring.set_password('fred', 'api_key', 'your_api_key')"
FRED_API_KEY=

# HTTP 配置
HTTP_BASE_URL=http://api.tushare.pro
HTTP_TIMEOUT=30.0

# 重试配置
RETRY_MAX_ATTEMPTS=3
RETRY_MULTIPLIER=1.0
RETRY_MIN_WAIT=1.0
RETRY_MAX_WAIT=10.0

# 限流配置
RATE_LIMIT_PROFILE=free
# RATE_LIMIT_GLOBAL_RATE=1000
# RATE_LIMIT_DAILY_RATE=5000

# 通达信数据源配置（用于质量对账）
TDX_PATH=D:\new_tdx\vipdoc
