# 日志配置
# shortcut: INFO 而非 DEBUG——worker 的 nohup 重定向 worker.log 无轮转,DEBUG 级 SQL 日志曾涨到 26G;需逐条 SQL 排查时临时改回
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_TO_CONSOLE=true
LOG_TO_FILE=true

# Tracing 配置
TRACING_ENABLED=true
TRACING_EXPORTER=otlp
TRACING_SAMPLE_RATE=1.0

# Metrics 配置
METRICS_ENABLED=true
METRICS_EXPORTER=otlp
VM_ENDPOINT=http://localhost:8428/opentelemetry/v1/metrics

# CORS 配置（development 环境固定为 localhost:3000 / 127.0.0.1:3000，无需配置）
# production 环境通过环境变量 CORS_ORIGINS 传入（逗号分隔），未设置时默认允许所有来源 (*)
# 示例: CORS_ORIGINS=https://app.ditto.example.com,https://admin.ditto.example.com
