# PIT (Point-in-Time) Configuration
# See config/pit/__init__.py for detailed documentation

# PIT Strategy: strict (enforce PIT), loose (allow late-arriving), latest (unsafe)
DITTO_PIT_STRATEGY=strict

# Rolling Window Closed Side: left (safe), right (unsafe), both (unsafe), none (safe)
# WARNING: Only 'left' and 'none' are PIT-safe for production use
DITTO_PIT_WINDOW_CLOSED=left

# Tolerance days for LOOSE strategy (default: 0)
# Only used when DITTO_PIT_STRATEGY=loose
DITTO_PIT_TOLERANCE_DAYS=0
