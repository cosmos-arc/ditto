{
  "alert_type": "signal_trading",
  "strategy_id": "{{ strategy_id }}",
  "strategy_name": "{{ strategy_name | default(strategy_id) }}",
  "signal_date": "{{ signal_date }}",
  "regime": {% if regime_label is defined %}{ "label": "{{ regime_label }}"{% if regime_score is defined %}, "score": {{ regime_score }}{% endif %} }{% else %}null{% endif %},
  "actions": [
    {% for a in actions %}
    { "instrument_id": {{ a.instrument_id | tojson }}, "action": {{ a.action | tojson }}, "target_weight": {{ a.target_weight | tojson }},
      "current_weight": {{ a.current_weight | tojson }}, "delta_weight": {{ a.delta_weight | tojson }} }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  "timestamp": "{{ timestamp | default('') }}"
}
