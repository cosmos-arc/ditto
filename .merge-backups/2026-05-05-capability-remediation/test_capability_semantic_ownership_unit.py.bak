"""Capability semantic ownership guardrail tests."""

from __future__ import annotations


def test_apps_capability_roots_include_all_domain_packages() -> None:
    from scripts.architecture.check_architecture_smells import (
        APPS_CAPABILITY_IMPORT_ROOTS,
    )

    assert {"ditto_portfolio", "ditto_risk"} <= APPS_CAPABILITY_IMPORT_ROOTS


def test_semantic_forbidden_terms_include_derived_feature_ownership() -> None:
    from scripts.architecture.check_architecture_smells import (
        DATA_FORBIDDEN_SEMANTIC_TERMS,
        PLATFORM_FORBIDDEN_DOMAIN_TERMS,
    )

    assert "features/" in DATA_FORBIDDEN_SEMANTIC_TERMS
    assert "factors/" in DATA_FORBIDDEN_SEMANTIC_TERMS
    assert "publication_safety" in DATA_FORBIDDEN_SEMANTIC_TERMS
    assert "instrument_id" in PLATFORM_FORBIDDEN_DOMAIN_TERMS
    assert "trade_date" in PLATFORM_FORBIDDEN_DOMAIN_TERMS


def test_data_semantic_guard_reports_derived_feature_ownership() -> None:
    from scripts.architecture.check_architecture_smells import (
        check_data_no_derived_feature_ownership,
    )

    errors = check_data_no_derived_feature_ownership(
        "\n".join(
            (
                'FEATURE_DATASET = "features/technical/indicators_narrow"',
                "from ditto_data.storage.runtime.publication_safety import "
                "CertificationReader",
            )
        ),
        "packages/data/src/ditto_data/config/data_store.py",
    )

    assert errors == [
        "packages/data/src/ditto_data/config/data_store.py: "
        "data owns derived feature semantic term 'features/'",
        "packages/data/src/ditto_data/config/data_store.py: "
        "data owns derived feature semantic term 'publication_safety'",
        "packages/data/src/ditto_data/config/data_store.py: "
        "data owns derived feature semantic term "
        "'ditto_data.storage.runtime.publication_'",
    ]


def test_platform_semantic_guard_reports_domain_terms() -> None:
    from scripts.architecture.check_architecture_smells import (
        check_platform_no_domain_terms,
    )

    errors = check_platform_no_domain_terms(
        'return ["instrument_id", "trade_date"]',
        "packages/platform/src/ditto_platform/foundation/storage/parquet_store.py",
    )

    assert errors == [
        "packages/platform/src/ditto_platform/foundation/storage/parquet_store.py: "
        "platform owns domain semantic term 'instrument_id'",
        "packages/platform/src/ditto_platform/foundation/storage/parquet_store.py: "
        "platform owns domain semantic term 'trade_date'",
    ]


def test_semantic_guards_skip_tests_docs_migrations_and_changelog_archives() -> None:
    from scripts.architecture.check_architecture_smells import (
        check_data_no_derived_feature_ownership,
        check_platform_no_domain_terms,
    )

    skipped_paths = (
        "packages/data/tests/unit/test_feature_dataset.py",
        "packages/data/docs/publication_safety.md",
        "packages/platform/src/ditto_platform/migrations/001_storage.py",
        "docs/changelog/archive/2026-05-04-platform.md",
    )

    for rel_path in skipped_paths:
        assert check_data_no_derived_feature_ownership("features/", rel_path) == []
        assert check_platform_no_domain_terms("instrument_id", rel_path) == []
