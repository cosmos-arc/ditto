# Ditto 量化系统环境配置模板
# 复制此文件为 .env 并填入实际值

# ===================================================================
# 系统基础配置
# ===================================================================
# 系统运行环境 (development/testing/production)
DITTO_ENV=development

# 日志级别 (TRACE/DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# 系统时区
TIMEZONE=Asia/Shanghai

# ===================================================================
# 数据库配置
# ===================================================================
# DuckDB 数据库路径 (分析型数据库)
DUCKDB_PATH=./data/duckdb/ditto.duckdb

# SQLite 数据库路径 (事务型数据库)
SQLITE_PATH=./data/sqlite/ditto.sqlite

# 数据库连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===================================================================
# 外部数据源配置
# ===================================================================
# Tushare Pro API 配置
# 注意：Tushare token 不再支持通过环境变量配置。
# 请使用以下方式之一配置 token：
# 1. Keyring（推荐）:
#    pixi run -e dev python -c "import keyring; keyring.set_password('ditto', 'tushare', 'your_token_here')"
# 2. ~/.ditto/secrets.toml:
#    [tushare]
#    token = "your_token_here"
TUSHARE_PRO_API_URL=https://api.tushare.pro

# API调用频率限制 (每分钟调用次数)
TUSHARE_RATE_LIMIT=200

# AkShare 配置 (备用数据源)
AKSHARE_ENABLE=true
AKSHARE_TIMEOUT=30

# 数据更新配置
DATA_UPDATE_ENABLED=true
DATA_UPDATE_TIME=02:30  # 每日更新时间 (HH:MM格式)
DATA_UPDATE_RETRY=3      # 失败重试次数

# ===================================================================
# FastAPI 服务配置
# ===================================================================
# 服务器配置
HOST=0.0.0.0
PORT=8000
WORKERS=1

# API配置
API_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc

# 安全配置
SECRET_KEY=your_secret_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS配置
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ===================================================================
# 交易执行配置 (Phase 2+ 使用)
# ===================================================================
# MiniQMT 配置
MINIQMT_ENABLE=false
MINIQMT_PATH=C:\Program Files (x86)\Thost\Monnitor.exe
MINIQMT_USER_ID=
MINIQMT_PASSWORD=

# 模拟交易配置
PAPER_TRADING_ENABLED=true
PAPER_TRADING_INITIAL_CAPITAL=100000.0
PAPER_TRADING_COMMISSION_RATE=0.0003  # 万3手续费
PAPER_TRADING_MIN_COMMISSION=5.0      # 最低手续费5元

# ===================================================================
# 风险管理配置
# ===================================================================
# Kill Switch 配置
KILL_SWITCH_ENABLED=true
KILL_SWITCH_DAILY_LOSS_THRESHOLD=0.02      # 日亏损阈值 2%
KILL_SWITCH_WEEKLY_LOSS_THRESHOLD=0.05    # 周亏损阈值 5%
KILL_SWITCH_MAX_DRAWDOWN_THRESHOLD=0.15   # 最大回撤阈值 15%
KILL_SWITCH_EMERGENCY_THRESHOLD=0.25      # 紧急止损阈值 25%

# 仓位限制
MAX_SINGLE_POSITION_WEIGHT=0.15           # 单只证券最大权重 15%
MAX_SECTOR_WEIGHT=0.30                     # 单行业最大权重 30%
MIN_CASH_RATIO=0.05                        # 最小现金比例 5%

# ===================================================================
# 通知配置
# ===================================================================
# Telegram 通知 (可选)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# 邮件通知 (可选)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_ENABLED=false

# ===================================================================
# 性能配置
# ===================================================================
# 并发配置
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30

# 缓存配置
CACHE_ENABLED=true
CACHE_TTL=3600  # 缓存时间(秒)

# ===================================================================
# 开发与调试配置
# ===================================================================
# 调试模式
DEBUG=false

# 性能分析
PROFILING_ENABLED=false

# Mock数据 (用于测试)
USE_MOCK_DATA=false

# ===================================================================
# 监控配置
# ===================================================================
# 健康检查
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60  # 秒

# 指标收集
METRICS_ENABLED=true
METRICS_PORT=9090

# ===================================================================
# 文件存储配置（遵循 XDG Base Directory 规范）
# ===================================================================
# 基础目录（所有路径的根）
# Windows 默认: D:\data\ditto
# Linux 默认: ~/.local/share/ditto
DITTO_BASE_DIR=D:\data\ditto

# 特定目录覆盖（可选，优先级高于 DITTO_BASE_DIR）
# DITTO_CONFIG_DIR=    # 配置文件目录
# DITTO_DATA_DIR=      # 数据文件目录
# DITTO_STATE_DIR=     # 状态文件目录（日志等）
# DITTO_CACHE_DIR=     # 缓存目录
# DITTO_RUNTIME_DIR=   # 运行时文件目录

# 旧环境变量（向后兼容，已弃用）
# DATA_ROOT=./data
# LOG_ROOT=./logs
# BACKUP_ROOT=./backups
# TEMP_ROOT=./temp

# 文件保留策略
LOG_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=90
TEMP_RETENTION_DAYS=7

# ===================================================================
# 机器学习配置 (Phase 3+ 使用)
# ===================================================================
# ML模型配置
ML_ENABLED=false
ML_MODEL_PATH=./models
ML_RETRAIN_INTERVAL=7  # 重训练间隔(天)
ML_PREDICTION_CONFIDENCE_THRESHOLD=0.7

# ===================================================================
# Web UI 配置 (Phase 1+ 使用)
# ===================================================================
# 前端配置
WEB_UI_ENABLED=false
WEB_UI_PORT=3000
WEB_UI_HOST=localhost

# ===================================================================
# 注意事项
# ===================================================================
# 1. 生产环境必须修改所有默认密钥和密码
# 2. 敏感信息不要提交到版本控制系统
# 3. 定期轮换API密钥和访问令牌
# 4. 监控API调用频率，避免触发限流
# 5. 备份重要的配置和数据文件
