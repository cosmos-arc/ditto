# Import Linter 配置文件
# 用于强制执行分层架构规则
#
# 运行检查：
#   pixi run -e dev arch-check
#   lint-imports
#   lint-imports --contract layered-architecture

[importlinter]
# 多个 root packages
root_packages =
    ditto_platform
    ditto_kernel
    ditto_data
    ditto_features
    ditto_analysis
    ditto_strategy
    ditto_portfolio
    ditto_risk
    ditto_execution
    ditto_backtest
    ditto_application
    ditto_apps

# 不包含外部包
include_external_packages = false

# 排除 TYPE_CHECKING 导入
exclude_type_checking_imports = true

# ═══════════════════════════════════════════════════════════════════
# 分层架构检查
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:layered-architecture]
name = Layered Architecture
type = layers
# Technical ordering for import-linter's `layers` contract.
# This is not the domain architecture model.
#
# Domain architecture is a diamond:
#   apps -> application -> {data, features, strategy, portfolio, risk, execution, backtest, analysis} -> kernel
#   platform is horizontal foundation.
#
# import-linter `layers` needs a sequence, so this contract only guards
# broad top-to-bottom imports. Parallel-plane isolation is enforced by
# the explicit forbidden contracts below.
layers =
    ditto_apps
    ditto_application
    ditto_portfolio
    ditto_analysis
    ditto_features
    ditto_data
    ditto_platform
# NOTE: ditto_strategy, ditto_risk, ditto_execution, and ditto_backtest not in
# layers — they have bidirectional or cross-layer dependencies with other packages.
# Isolation is enforced by explicit forbidden contracts below.

# ═══════════════════════════════════════════════════════════════════
# Kernel 层隔离：禁止依赖其他层
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:kernel-isolation]
name = Kernel must not depend on other layers
type = forbidden
source_modules =
    ditto_kernel.**
forbidden_modules =
    ditto_data.**
    ditto_apps.**
    ditto_application.**
    ditto_platform.**
    ditto_features.**
    ditto_analysis.**
    ditto_strategy.**
    ditto_portfolio.**
    ditto_risk.**
    ditto_execution.**
    ditto_backtest.**

# ═══════════════════════════════════════════════════════════════════
# Platform 层隔离：禁止依赖业务层（允许依赖 kernel）
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:platform-isolation]
name = Platform must not depend on business layers (kernel allowed)
type = forbidden
source_modules =
    ditto_platform.**
forbidden_modules =
    ditto_data.**
    ditto_apps.**
    ditto_kernel.**
    ditto_features.**
    ditto_analysis.**
    ditto_strategy.**
    ditto_risk.**
    ditto_execution.**
    ditto_backtest.**
    ditto_application.**
# PlatformError 继承 DittoError（全局异常根），这是跨层共享的合法依赖
ignore_imports =
    ditto_platform.exceptions -> ditto_kernel.exceptions
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# Platform storage 纯技术基础设施：禁止包含业务逻辑
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:platform-storage-no-business]
name = Platform storage must not contain business logic
type = forbidden
source_modules =
    ditto_platform.foundation.storage.**
forbidden_modules =
    ditto_data.**
    ditto_features.**
    ditto_strategy.**
    ditto_portfolio.**
    ditto_risk.**
    ditto_execution.**
    ditto_backtest.**
    ditto_analysis.**
    ditto_application.**
    ditto_apps.**

# ═══════════════════════════════════════════════════════════════════
# Data 层边界：禁止依赖上层/同级包
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:data-boundary]
name = Data must not depend on Apps/Application/Analytics/Features/Analysis/Strategy
type = forbidden
source_modules =
    ditto_data.**
forbidden_modules =
    ditto_apps.**
    ditto_application.**
    ditto_features.**
    ditto_analysis.**
    ditto_strategy.**
    ditto_portfolio.**
    ditto_risk.**
    ditto_execution.**
    ditto_backtest.**
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# Features 层隔离：禁止依赖 Data/Strategy 等
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:features-boundary]
name = Features must not depend on Data/Strategy/Apps/Application/Analysis/Portfolio
type = forbidden
source_modules =
    ditto_features.**
forbidden_modules =
    ditto_data.**
    ditto_apps.**
    ditto_application.**
    ditto_analysis.**
    ditto_strategy.**
    ditto_portfolio.**
    ditto_risk.**
    ditto_execution.**
    ditto_backtest.**
unmatched_ignore_imports_alerting = warn

# Features 内部方向：expression 禁止依赖 materialization
[importlinter:contract:features-expression-no-materialization]
name = Features expression must not import materialization
type = forbidden
source_modules =
    ditto_features.expression.**
forbidden_modules =
    ditto_features.materialization.**

# ═══════════════════════════════════════════════════════════════════
# Strategy 层边界：禁止依赖 application/apps，storage 禁止依赖 execution
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:strategy-boundary]
name = Strategy must not depend on data/features/portfolio/risk/execution/backtest/analysis/application/apps
type = forbidden
source_modules =
    ditto_strategy.**
forbidden_modules =
    ditto_data.**
    ditto_features.**
    ditto_portfolio.**
    ditto_risk.**
    ditto_apps.**
    ditto_application.**
    ditto_backtest.**
    ditto_analysis.**
    ditto_execution.**
unmatched_ignore_imports_alerting = warn

[importlinter:contract:strategy-storage-no-execution]
name = Strategy storage must not depend on execution
type = forbidden
source_modules =
    ditto_strategy.storage.**
forbidden_modules =
    ditto_execution.**
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# Portfolio 层隔离：禁止依赖下游能力包
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:portfolio-boundary]
name = Portfolio must not depend on data/features/strategy/risk/execution/backtest/analysis/application/apps
type = forbidden
source_modules =
    ditto_portfolio.**
forbidden_modules =
    ditto_data.**
    ditto_features.**
    ditto_strategy.**
    ditto_analysis.**
    ditto_apps.**
    ditto_application.**
    ditto_risk.**
    ditto_execution.**
    ditto_backtest.**
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# Risk 层隔离：禁止依赖 execution/backtest/application/apps
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:risk-boundary]
name = Risk must not depend on data/features/strategy/execution/backtest/analysis/application/apps
type = forbidden
source_modules =
    ditto_risk.**
forbidden_modules =
    ditto_data.**
    ditto_features.**
    ditto_strategy.**
    ditto_apps.**
    ditto_application.**
    ditto_backtest.**
    ditto_analysis.**
    ditto_execution.**
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# Execution 层隔离：禁止依赖 backtest/analysis/application/apps
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:execution-boundary]
name = Execution must not depend on data/features/strategy/risk/backtest/analysis/application/apps
type = forbidden
source_modules =
    ditto_execution.**
forbidden_modules =
    ditto_apps.**
    ditto_application.**
    ditto_backtest.**
    ditto_analysis.**
    ditto_strategy.**
    ditto_features.**
    ditto_risk.**
    ditto_data.**
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# Backtest 层隔离：禁止依赖 broker gateways / analysis / apps / application
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:backtest-boundary]
name = Backtest must not depend on broker gateways/analysis/application/apps/features/platform
type = forbidden
source_modules =
    ditto_backtest.**
forbidden_modules =
    ditto_analysis.**
    ditto_apps.**
    ditto_application.**
    ditto_execution.broker.gateways.**
    ditto_features.**
    ditto_platform.**
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# 生产包禁止导入 Analysis 层（反向约束）
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:production-no-analysis]
name = Production packages must not import analysis
type = forbidden
source_modules =
    ditto_data.**
    ditto_features.**
    ditto_strategy.**
    ditto_portfolio.**
    ditto_risk.**
    ditto_execution.**
    ditto_backtest.**
forbidden_modules =
    ditto_analysis.**
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# 生产包禁止依赖 Analysis 层
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:analysis-no-production-dependency]
name = Analysis must not depend on production packages
type = forbidden
source_modules =
    ditto_analysis.**
forbidden_modules =
    ditto_data.**
    ditto_apps.**
    ditto_application.**
    ditto_features.**
    ditto_strategy.**
    ditto_portfolio.**
    ditto_risk.**
    ditto_execution.**
    ditto_backtest.**
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# Apps 层边界：禁止直接依赖 Data 存储/运行时实现
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:apps-boundary]
name = Apps must not directly depend on Data storage/runtime
type = forbidden
source_modules =
    ditto_apps.**
forbidden_modules =
    ditto_data.storage.**
    ditto_data.runtime.**
# 只检查直接导入，允许通过 hub 的间接使用
allow_indirect_imports = true

# ═══════════════════════════════════════════════════════════════════
# Apps 层边界：禁止直接依赖 Data 服务/模型（逐步收紧）
#
# Composition Root 豁免：registry/** 是 DI 组装点，允许直接导入
# Data services/quality 以完成 Provider 装配和 Context Bundle 构建。
# 非registry代码必须通过 Application 层或 DI 容器间接访问。
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:apps-service-isolation]
name = Apps must not directly depend on Data services/models (tightening)
type = forbidden
source_modules =
    ditto_apps.**
forbidden_modules =
    ditto_data.services.**
    ditto_data.services
    ditto_data.models.**
    ditto_data.models
    ditto_data.errors.**
    ditto_data.errors
    ditto_data.quality.**
    ditto_data.quality
    ditto_data.config.**
    ditto_data.config
# Registry 豁免（Composition Root）
ignore_imports =
    ditto_apps.registry.** -> ditto_data.services.**
    ditto_apps.registry.** -> ditto_data.quality.**
    ditto_apps.registry.** -> ditto_data.config
    ditto_apps.registry.** -> ditto_data.config.**
    ditto_apps.jobs.context -> ditto_data.quality
    ditto_apps.jobs.context -> ditto_data.quality.protocols
    # intentional debt: DQ types consumed by apps.jobs context (tracked for kernel candidacy)
    ditto_apps.jobs.tasks.dq_batch -> ditto_data.quality.quality_types
    ditto_apps.jobs.tasks.monitoring -> ditto_data.quality.quality_types
allow_indirect_imports = true
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# Application 层边界：禁止依赖 Apps 层
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:application-no-apps-import]
name = Application must not import Apps layer
type = forbidden
source_modules =
    ditto_application.**
forbidden_modules =
    ditto_apps.**

# ═══════════════════════════════════════════════════════════════════
# Application → Platform 范围约束：允许 foundation + services，禁止 config
# config 加载由 Apps 层负责
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:app-platform-scope]
name = Application must not access ditto_platform.config
type = forbidden
source_modules =
    ditto_application.**
forbidden_modules =
    ditto_platform.config.**

# ═══════════════════════════════════════════════════════════════════
# R8 — Application 内部互斥规则（Use Case 间职责隔离）
# ═══════════════════════════════════════════════════════════════════
# 矩阵：
#   app.query     -X-> app.process, app.builders, app.command  (只读)
#   app.process   ->  app.query                                (允许协调)
#   app.builders  -X-> app.query                               (只装配)
#   app.command   -X-> app.query, app.builders                 (纯写入)
#   process <-> builders 允许双向
#   command -> process 允许（委托执行）
# ═══════════════════════════════════════════════════════════════════

[importlinter:contract:r8-queries-no-processes]
name = R8: app.queries must not import app.processes
type = forbidden
source_modules =
    ditto_application.queries.**
forbidden_modules =
    ditto_application.processes.**

[importlinter:contract:r8-queries-no-builders]
name = R8: app.queries must not import app.builders
type = forbidden
source_modules =
    ditto_application.queries.**
forbidden_modules =
    ditto_application.builders.**

[importlinter:contract:r8-builders-no-queries]
name = R8: app.builders must not import app.queries
type = forbidden
source_modules =
    ditto_application.builders.**
forbidden_modules =
    ditto_application.queries.**

[importlinter:contract:r8-queries-no-commands]
name = R8: app.queries must not import app.commands
type = forbidden
source_modules =
    ditto_application.queries.**
forbidden_modules =
    ditto_application.commands.**

[importlinter:contract:r8-commands-no-queries]
name = R8: app.commands must not import app.queries
type = forbidden
source_modules =
    ditto_application.commands.**
forbidden_modules =
    ditto_application.queries.**

[importlinter:contract:r8-commands-no-builders]
name = R8: app.commands must not import app.builders
type = forbidden
source_modules =
    ditto_application.commands.**
forbidden_modules =
    ditto_application.builders.**

# ═══════════════════════════════════════════════════════════════════
# Data 内部边界：storage 与 sources/models 的隔离
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:data-storage-no-model-import]
name = Data storage must not import data models directly
type = forbidden
source_modules =
    ditto_data.storage.**
forbidden_modules =
    ditto_data.models.**
    ditto_data.models
# CQRS Writer/Reader 需要模型类型定义（Record 等）
ignore_imports =
    ditto_data.storage.** -> ditto_data.models.metadata
    ditto_data.storage.** -> ditto_data.models.macro
    ditto_data.storage.** -> ditto_data.models.ingestion
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-sources-no-storage-import]
name = Data sources must not import data storage
type = forbidden
source_modules =
    ditto_data.sources.**
forbidden_modules =
    ditto_data.storage.**
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# Data sources 子域交叉隔离：各数据源互相禁止导入
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:data-sources-tushare-isolation]
name = Data source tushare must not import tdx/fred
type = forbidden
source_modules =
    ditto_data.sources.tushare.**
forbidden_modules =
    ditto_data.sources.tdx.**
    ditto_data.sources.fred.**
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-sources-tdx-isolation]
name = Data source tdx must not import tushare/fred
type = forbidden
source_modules =
    ditto_data.sources.tdx.**
forbidden_modules =
    ditto_data.sources.tushare.**
    ditto_data.sources.fred.**
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-sources-fred-isolation]
name = Data source fred must not import tushare/tdx
type = forbidden
source_modules =
    ditto_data.sources.fred.**
forbidden_modules =
    ditto_data.sources.tushare.**
    ditto_data.sources.tdx.**
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# Data storage 子域交叉隔离：各子域互相禁止导入
# storage/base 和 storage/schemas 是共享基类，不在隔离范围
# importlinter forbidden 类型不支持 source/forbidden 集重叠，
# 因此按子域拆分为独立规则
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:data-storage-market-isolation]
name = Data storage market must not import other storage subdomains
type = forbidden
source_modules =
    ditto_data.storage.market.**
forbidden_modules =
    ditto_data.storage.fundamental.**
    ditto_data.storage.capital.**
    ditto_data.storage.metadata.**
    ditto_data.storage.runtime.**
    ditto_data.storage.macro.**
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-storage-fundamental-isolation]
name = Data storage fundamental must not import other storage subdomains
type = forbidden
source_modules =
    ditto_data.storage.fundamental.**
forbidden_modules =
    ditto_data.storage.market.**
    ditto_data.storage.capital.**
    ditto_data.storage.metadata.**
    ditto_data.storage.runtime.**
    ditto_data.storage.macro.**
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-storage-capital-isolation]
name = Data storage capital must not import other storage subdomains
type = forbidden
source_modules =
    ditto_data.storage.capital.**
forbidden_modules =
    ditto_data.storage.market.**
    ditto_data.storage.fundamental.**
    ditto_data.storage.metadata.**
    ditto_data.storage.runtime.**
    ditto_data.storage.macro.**
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-storage-metadata-isolation]
name = Data storage metadata must not import other storage subdomains
type = forbidden
source_modules =
    ditto_data.storage.metadata.**
forbidden_modules =
    ditto_data.storage.market.**
    ditto_data.storage.fundamental.**
    ditto_data.storage.capital.**
    ditto_data.storage.runtime.**
    ditto_data.storage.macro.**
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-storage-runtime-isolation]
name = Data storage runtime must not import other storage subdomains
type = forbidden
source_modules =
    ditto_data.storage.runtime.**
forbidden_modules =
    ditto_data.storage.market.**
    ditto_data.storage.fundamental.**
    ditto_data.storage.capital.**
    ditto_data.storage.metadata.**
    ditto_data.storage.macro.**
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# 循环依赖检测
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:acyclic-packages]
name = No circular dependencies between packages
type = acyclic_siblings
ancestors =
    ditto_platform
    ditto_kernel
    ditto_data
    ditto_features
    ditto_analysis
    ditto_strategy
    ditto_portfolio
    ditto_risk
    ditto_execution
    ditto_backtest
    ditto_application
    ditto_apps
depth = 10
unmatched_ignore_imports_alerting = warn
