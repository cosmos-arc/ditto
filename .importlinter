# Import Linter 配置文件
# 用于强制执行分层架构规则
#
# 运行检查：
#   pixi run -e dev arch-check
#   lint-imports
#   lint-imports --contract layered-architecture

[importlinter]
# 多个 root packages
root_packages =
    ditto_infra
    ditto_kernel
    ditto_datahub
    ditto_data
    ditto_analytics
    ditto_engine
    ditto_app
    ditto_port

# 不包含外部包
include_external_packages = false

# 排除 TYPE_CHECKING 导入
exclude_type_checking_imports = true

# ═══════════════════════════════════════════════════════════════════
# 分层架构检查
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:layered-architecture]
name = Layered Architecture
type = layers
# 从高层到低层：Port → App → Engine → DataHub → Infra
# Kernel 在最底层，但 layers 检查不包含它（Kernel 无业务依赖，被所有层依赖）
layers =
    ditto_port
    ditto_app
    ditto_engine
    ditto_datahub
    ditto_infra

# ═══════════════════════════════════════════════════════════════════
# Kernel 层隔离：禁止依赖其他层
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:kernel-isolation]
name = Kernel must not depend on other layers
type = forbidden
source_modules =
    ditto_kernel.**
forbidden_modules =
    ditto_engine.**
    ditto_datahub.**
    ditto_port.**
    ditto_app.**
    ditto_infra.**
    ditto_data.**
    ditto_analytics.**

# ═══════════════════════════════════════════════════════════════════
# Infra 层隔离：禁止依赖其他层
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:foundation-isolation]
name = Infra must not depend on other layers
type = forbidden
source_modules =
    ditto_infra.**
forbidden_modules =
    ditto_datahub.**
    ditto_engine.**
    ditto_port.**
    ditto_kernel.**
    ditto_data.**
    ditto_analytics.**
    ditto_app.**

# ═══════════════════════════════════════════════════════════════════
# Data 层边界：禁止依赖 Engine/Port
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:data-boundary]
name = Data must not depend on Engine/Port
type = forbidden
source_modules =
    ditto_data.**
forbidden_modules =
    ditto_engine.**
    ditto_port.**
    ditto_app.**
unmatched_ignore_imports_alerting = none

# ═══════════════════════════════════════════════════════════════════
# Analytics 层隔离：禁止依赖 DataHub/Port
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:analytics-no-datahub-import]
name = Analytics must not depend on DataHub
type = forbidden
source_modules =
    ditto_analytics.**
forbidden_modules =
    ditto_datahub.**
ignore_imports =
    ditto_analytics.** -> ditto_engine.engine.specs
unmatched_ignore_imports_alerting = none

[importlinter:contract:analytics-must-not-depend-on-port]
name = Analytics must not depend on Port
type = forbidden
source_modules =
    ditto_analytics.**
forbidden_modules =
    ditto_port.**
unmatched_ignore_imports_alerting = none

# ═══════════════════════════════════════════════════════════════════
# DataHub 层边界：禁止依赖 Engine/Port/App
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:datahub-boundary]
name = DataHub must not depend on Core/Port/App
type = forbidden
source_modules =
    ditto_datahub.**
forbidden_modules =
    ditto_engine.**
    ditto_port.**
    ditto_app.**

# ═══════════════════════════════════════════════════════════════════
# Engine ↔ DataHub 边界：双向禁止互相依赖
# 两者均可依赖 ditto_kernel
# Engine 保留对 ditto_datahub.errors 的 re-export 依赖
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:core-must-not-depend-on-datahub]
name = Engine must not depend on DataHub (except errors)
type = forbidden
source_modules =
    ditto_engine.**
forbidden_modules =
    ditto_datahub.**
    ditto_data.**
ignore_imports =
    ditto_engine.** -> ditto_kernel.*
    ditto_engine.** -> ditto_datahub.errors
    ditto_engine.** -> ditto_data.errors
unmatched_ignore_imports_alerting = none

[importlinter:contract:datahub-must-not-depend-on-core]
name = DataHub must not depend on Engine
type = forbidden
source_modules =
    ditto_datahub.**
forbidden_modules =
    ditto_engine.**
ignore_imports =
    ditto_datahub.** -> ditto_kernel.*
unmatched_ignore_imports_alerting = none

# ═══════════════════════════════════════════════════════════════════
# Port 层边界：禁止直接依赖 DataHub 存储/运行时实现
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:port-boundary]
name = Port must not directly depend on DataHub stores/runtime
type = forbidden
source_modules =
    ditto_port.**
forbidden_modules =
    ditto_datahub.stores.**
    ditto_datahub.runtime.**
# 忽略 registry 模块的导入
ignore_imports =
    ditto_port.registry.** -> ditto_datahub.stores.**
    ditto_port.registry.** -> ditto_datahub.runtime.**
# 只检查直接导入，允许通过 hub 的间接使用
allow_indirect_imports = true
unmatched_ignore_imports_alerting = none

# ═══════════════════════════════════════════════════════════════════
# App 层边界：禁止依赖 Port 层
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:app-no-port-import]
name = App must not import Port layer
type = forbidden
source_modules =
    ditto_app.**
forbidden_modules =
    ditto_port.**

# ═══════════════════════════════════════════════════════════════════
# R8 — App 内部互斥规则（Use Case 间职责隔离）
# ═══════════════════════════════════════════════════════════════════
# 矩阵：
#   app.query     -X-> app.command, app.process, app.builders  (只读)
#   app.command   -X-> app.query, app.process                  (单次写)
#   app.process   ->  app.query, app.command                   (允许协调)
#   app.builders  -X-> app.query, app.command                  (只装配)
#   process <-> builders 允许双向
# ═══════════════════════════════════════════════════════════════════

[importlinter:contract:r8-query-no-command]
name = R8: app.query must not import app.command
type = forbidden
source_modules =
    ditto_app.query.**
forbidden_modules =
    ditto_app.command.**
unmatched_ignore_imports_alerting = none

[importlinter:contract:r8-query-no-process]
name = R8: app.query must not import app.process
type = forbidden
source_modules =
    ditto_app.query.**
forbidden_modules =
    ditto_app.process.**
unmatched_ignore_imports_alerting = none

[importlinter:contract:r8-query-no-builders]
name = R8: app.query must not import app.builders
type = forbidden
source_modules =
    ditto_app.query.**
forbidden_modules =
    ditto_app.builders.**
unmatched_ignore_imports_alerting = none

[importlinter:contract:r8-command-no-query]
name = R8: app.command must not import app.query
type = forbidden
source_modules =
    ditto_app.command.**
forbidden_modules =
    ditto_app.query.**
unmatched_ignore_imports_alerting = none

[importlinter:contract:r8-command-no-process]
name = R8: app.command must not import app.process
type = forbidden
source_modules =
    ditto_app.command.**
forbidden_modules =
    ditto_app.process.**
unmatched_ignore_imports_alerting = none

[importlinter:contract:r8-builders-no-query]
name = R8: app.builders must not import app.query
type = forbidden
source_modules =
    ditto_app.builders.**
forbidden_modules =
    ditto_app.query.**
unmatched_ignore_imports_alerting = none

[importlinter:contract:r8-builders-no-command]
name = R8: app.builders must not import app.command
type = forbidden
source_modules =
    ditto_app.builders.**
forbidden_modules =
    ditto_app.command.**
unmatched_ignore_imports_alerting = none

# ═══════════════════════════════════════════════════════════════════
# 循环依赖检测
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:acyclic-packages]
name = No circular dependencies between packages
type = acyclic_siblings
ancestors =
    ditto_infra
    ditto_kernel
    ditto_datahub
    ditto_data
    ditto_analytics
    ditto_engine
    ditto_app
    ditto_port
depth = 10
