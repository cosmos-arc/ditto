# Import Linter 配置文件
# 用于强制执行分层架构规则
#
# 运行检查：
#   pixi run -e dev arch-check
#   lint-imports
#   lint-imports --contract layered-architecture

[importlinter]
# 多个 root packages
root_packages =
    ditto_platform
    ditto_kernel
    ditto_data
    ditto_analytics
    ditto_engine
    ditto_application
    ditto_apps

# 不包含外部包
include_external_packages = false

# 排除 TYPE_CHECKING 导入
exclude_type_checking_imports = true

# ═══════════════════════════════════════════════════════════════════
# 分层架构检查
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:layered-architecture]
name = Layered Architecture
type = layers
# Technical ordering for import-linter's `layers` contract.
# This is not the domain architecture model.
#
# Domain architecture is a diamond:
#   interfaces -> app -> {data, analytics, engine} -> kernel
#   platform is horizontal foundation.
#
# import-linter `layers` needs a sequence, so this contract only guards
# broad top-to-bottom imports. Parallel-plane isolation is enforced by
# the explicit forbidden contracts below.
layers =
    ditto_apps
    ditto_application
    ditto_engine
    ditto_data
    ditto_platform

# ═══════════════════════════════════════════════════════════════════
# Kernel 层隔离：禁止依赖其他层
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:kernel-isolation]
name = Kernel must not depend on other layers
type = forbidden
source_modules =
    ditto_kernel.**
forbidden_modules =
    ditto_engine.**
    ditto_data.**
    ditto_apps.**
    ditto_application.**
    ditto_platform.**
    ditto_analytics.**

# ═══════════════════════════════════════════════════════════════════
# Platform 层隔离：禁止依赖其他层
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:platform-isolation]
name = Platform must not depend on other layers
type = forbidden
source_modules =
    ditto_platform.**
forbidden_modules =
    ditto_data.**
    ditto_engine.**
    ditto_apps.**
    ditto_kernel.**
    ditto_analytics.**
    ditto_application.**
# PlatformError 继承 DittoError（全局异常根），这是跨层共享的合法依赖
ignore_imports =
    ditto_platform.exceptions -> ditto_kernel.exceptions
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# Data 层边界：禁止依赖 Engine/Apps/App
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:data-boundary]
name = Data must not depend on Engine/Apps/App/Analytics
type = forbidden
source_modules =
    ditto_data.**
forbidden_modules =
    ditto_engine.**
    ditto_apps.**
    ditto_application.**
    ditto_analytics.**

# ═══════════════════════════════════════════════════════════════════
# Analytics 层隔离：禁止依赖 Data/Engine/Apps
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:analytics-isolation]
name = Analytics must not depend on Data/Engine
type = forbidden
source_modules =
    ditto_analytics.**
forbidden_modules =
    ditto_data.**
    ditto_engine.**
ignore_imports =
    # Analytics 引用 data.errors 是合法的：DerivedNotImplementedError 等类型供编译/验证使用
    ditto_analytics.** -> ditto_data.errors
unmatched_ignore_imports_alerting = warn

[importlinter:contract:analytics-must-not-depend-on-interfaces]
name = Analytics must not depend on Applications
type = forbidden
source_modules =
    ditto_analytics.**
forbidden_modules =
    ditto_apps.**

# Analytics 内部方向：expression 禁止依赖 materialization
[importlinter:contract:analytics-expression-no-materialization]
name = Analytics expression must not import materialization
type = forbidden
source_modules =
    ditto_analytics.expression.**
forbidden_modules =
    ditto_analytics.materialization.**

# ═══════════════════════════════════════════════════════════════════
# Engine ↔ Data 边界：双向禁止互相依赖
# 两者均可依赖 ditto_kernel
# Engine 仅保留 DataProvider Protocol 依赖
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:engine-no-data-dependency]
name = Engine must not depend on Data (except provider)
type = forbidden
source_modules =
    ditto_engine.**
forbidden_modules =
    ditto_data.**
ignore_imports =
    # DataProvider Protocol 位置（Phase 5 从 kernel 移入 ditto_data，需 polars 返回类型）
    ditto_engine.** -> ditto_data.provider
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-no-engine-dependency]
name = Data must not depend on Engine
type = forbidden
source_modules =
    ditto_data.**
forbidden_modules =
    ditto_engine.**

# ═══════════════════════════════════════════════════════════════════
# Engine 层隔离：禁止依赖 Platform
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:engine-no-platform-dependency]
name = Engine must not depend on Platform
type = forbidden
source_modules =
    ditto_engine.**
forbidden_modules =
    ditto_platform.**

# ═══════════════════════════════════════════════════════════════════
# Engine 与 Analytics 互相隔离：平行平面，互不依赖
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:engine-no-analytics-dependency]
name = Engine must not depend on Analytics
type = forbidden
source_modules =
    ditto_engine.**
forbidden_modules =
    ditto_analytics.**

# ═══════════════════════════════════════════════════════════════════
# Analytics 与 Application 互斥：平行平面，互不依赖
# Application 通过 builders 层使用 Analytics（表达式编译/因子计算）
# Analytics 禁止反向依赖 Application
# 注意：Application → Analytics 方向由分层架构隐式允许（无对应 forbidden 合约）。
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:analytics-no-app-dependency]
name = Analytics must not depend on Application
type = forbidden
source_modules =
    ditto_analytics.**
forbidden_modules =
    ditto_application.**

# ═══════════════════════════════════════════════════════════════════
# Apps 层边界：禁止直接依赖 Data 存储/运行时实现
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:interfaces-boundary]
name = Apps must not directly depend on Data storage/runtime
type = forbidden
source_modules =
    ditto_apps.**
forbidden_modules =
    ditto_data.storage.**
    ditto_data.runtime.**
# 只检查直接导入，允许通过 hub 的间接使用
allow_indirect_imports = true

# ═══════════════════════════════════════════════════════════════════
# Apps 层边界：禁止直接依赖 Data 服务/模型（逐步收紧）
#
# Composition Root 豁免：registry/** 是 DI 组装点，允许直接导入
# Data services/quality 以完成 Provider 装配和 Context Bundle 构建。
# 非registry代码必须通过 Application 层或 DI 容器间接访问。
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:interfaces-service-isolation]
name = Apps must not directly depend on Data services/models (tightening)
type = forbidden
source_modules =
    ditto_apps.**
forbidden_modules =
    ditto_data.services.**
    ditto_data.models.**
    ditto_data.errors.**
    ditto_data.quality.**
    ditto_data.config.**
# Registry 豁免（Composition Root）
ignore_imports =
    ditto_apps.registry.** -> ditto_data.services.**
    ditto_apps.registry.** -> ditto_data.quality.**
    ditto_apps.registry.** -> ditto_data.config.**
    ditto_apps.jobs.context -> ditto_data.quality
    ditto_apps.jobs.context -> ditto_data.quality.protocols
    # Dataset StrEnum 是系统级枚举，API/CLI 需要列出已知数据集
    ditto_apps.api.routes.ingestion -> ditto_data.models.common
    ditto_apps.cli.commands.ops -> ditto_data.models.common
allow_indirect_imports = true
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# Application 层边界：禁止依赖 Apps 层
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:app-no-interfaces-import]
name = Application must not import Apps layer
type = forbidden
source_modules =
    ditto_application.**
forbidden_modules =
    ditto_apps.**

# ═══════════════════════════════════════════════════════════════════
# Application → Platform 范围约束：允许 foundation + services，禁止 config
# config 加载由 Apps 层负责
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:app-platform-scope]
name = Application must not access ditto_platform.config
type = forbidden
source_modules =
    ditto_application.**
forbidden_modules =
    ditto_platform.config.**
ignore_imports =
    ditto_application.** -> ditto_platform.foundation.**
    ditto_application.** -> ditto_platform.services.**

# ═══════════════════════════════════════════════════════════════════
# R8 — Application 内部互斥规则（Use Case 间职责隔离）
# ═══════════════════════════════════════════════════════════════════
# 矩阵：
#   app.query     -X-> app.process, app.builders, app.command  (只读)
#   app.process   ->  app.query                                (允许协调)
#   app.builders  -X-> app.query                               (只装配)
#   app.command   -X-> app.query, app.builders                 (纯写入)
#   process <-> builders 允许双向
#   command -> process 允许（委托执行）
# ═══════════════════════════════════════════════════════════════════

[importlinter:contract:r8-query-no-process]
name = R8: app.query must not import app.process
type = forbidden
source_modules =
    ditto_application.query.**
forbidden_modules =
    ditto_application.process.**

[importlinter:contract:r8-query-no-builders]
name = R8: app.query must not import app.builders
type = forbidden
source_modules =
    ditto_application.query.**
forbidden_modules =
    ditto_application.builders.**

[importlinter:contract:r8-builders-no-query]
name = R8: app.builders must not import app.query
type = forbidden
source_modules =
    ditto_application.builders.**
forbidden_modules =
    ditto_application.query.**

[importlinter:contract:r8-query-no-command]
name = R8: app.query must not import app.command
type = forbidden
source_modules =
    ditto_application.query.**
forbidden_modules =
    ditto_application.command.**

[importlinter:contract:r8-command-no-query]
name = R8: app.command must not import app.query
type = forbidden
source_modules =
    ditto_application.command.**
forbidden_modules =
    ditto_application.query.**

[importlinter:contract:r8-command-no-builders]
name = R8: app.command must not import app.builders
type = forbidden
source_modules =
    ditto_application.command.**
forbidden_modules =
    ditto_application.builders.**

# ═══════════════════════════════════════════════════════════════════
# Data 内部边界：storage 与 sources/models 的隔离
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:data-storage-no-model-import]
name = Data storage must not import data models directly
type = forbidden
source_modules =
    ditto_data.storage.**
forbidden_modules =
    ditto_data.models.**
# CQRS Writer/Reader 需要模型类型定义（OnDuplicate, WriteStoreResult, Record 等）
# 这是 storage 层与 model 层的自然耦合，全部均为合法的类型注解
ignore_imports =
    ditto_data.storage.** -> ditto_data.models
    ditto_data.storage.** -> ditto_data.models.storage
    ditto_data.storage.** -> ditto_data.models.metadata
    ditto_data.storage.** -> ditto_data.models.macro
    ditto_data.storage.** -> ditto_data.models.strategy
    ditto_data.storage.** -> ditto_data.models.strategy_run
    ditto_data.storage.** -> ditto_data.models.trade
    ditto_data.storage.** -> ditto_data.models.derived
    ditto_data.storage.** -> ditto_data.models.publication_safety
    ditto_data.storage.** -> ditto_data.models.ingestion
    ditto_data.storage.** -> ditto_data.models.common
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-sources-no-storage-import]
name = Data sources must not import data storage
type = forbidden
source_modules =
    ditto_data.sources.**
forbidden_modules =
    ditto_data.storage.**
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# Data sources 子域交叉隔离：各数据源互相禁止导入
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:data-sources-tushare-isolation]
name = Data source tushare must not import tdx/fred
type = forbidden
source_modules =
    ditto_data.sources.tushare.**
forbidden_modules =
    ditto_data.sources.tdx.**
    ditto_data.sources.fred.**
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-sources-tdx-isolation]
name = Data source tdx must not import tushare/fred
type = forbidden
source_modules =
    ditto_data.sources.tdx.**
forbidden_modules =
    ditto_data.sources.tushare.**
    ditto_data.sources.fred.**
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-sources-fred-isolation]
name = Data source fred must not import tushare/tdx
type = forbidden
source_modules =
    ditto_data.sources.fred.**
forbidden_modules =
    ditto_data.sources.tushare.**
    ditto_data.sources.tdx.**
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# Data storage 子域交叉隔离：各子域互相禁止导入
# storage/base 和 storage/schemas 是共享基类，不在隔离范围
# importlinter forbidden 类型不支持 source/forbidden 集重叠，
# 因此按子域拆分为独立规则
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:data-storage-market-isolation]
name = Data storage market must not import other storage subdomains
type = forbidden
source_modules =
    ditto_data.storage.market.**
forbidden_modules =
    ditto_data.storage.fundamental.**
    ditto_data.storage.capital.**
    ditto_data.storage.metadata.**
    ditto_data.storage.runtime.**
    ditto_data.storage.execution.**
    ditto_data.storage.factors.**
    ditto_data.storage.features.**
    ditto_data.storage.macro.**
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-storage-fundamental-isolation]
name = Data storage fundamental must not import other storage subdomains
type = forbidden
source_modules =
    ditto_data.storage.fundamental.**
forbidden_modules =
    ditto_data.storage.market.**
    ditto_data.storage.capital.**
    ditto_data.storage.metadata.**
    ditto_data.storage.runtime.**
    ditto_data.storage.execution.**
    ditto_data.storage.factors.**
    ditto_data.storage.features.**
    ditto_data.storage.macro.**
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-storage-capital-isolation]
name = Data storage capital must not import other storage subdomains
type = forbidden
source_modules =
    ditto_data.storage.capital.**
forbidden_modules =
    ditto_data.storage.market.**
    ditto_data.storage.fundamental.**
    ditto_data.storage.metadata.**
    ditto_data.storage.runtime.**
    ditto_data.storage.execution.**
    ditto_data.storage.factors.**
    ditto_data.storage.features.**
    ditto_data.storage.macro.**
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-storage-metadata-isolation]
name = Data storage metadata must not import other storage subdomains
type = forbidden
source_modules =
    ditto_data.storage.metadata.**
forbidden_modules =
    ditto_data.storage.market.**
    ditto_data.storage.fundamental.**
    ditto_data.storage.capital.**
    ditto_data.storage.runtime.**
    ditto_data.storage.execution.**
    ditto_data.storage.factors.**
    ditto_data.storage.features.**
    ditto_data.storage.macro.**
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-storage-runtime-isolation]
name = Data storage runtime must not import other storage subdomains
type = forbidden
source_modules =
    ditto_data.storage.runtime.**
forbidden_modules =
    ditto_data.storage.market.**
    ditto_data.storage.fundamental.**
    ditto_data.storage.capital.**
    ditto_data.storage.metadata.**
    ditto_data.storage.execution.**
    ditto_data.storage.factors.**
    ditto_data.storage.features.**
    ditto_data.storage.macro.**
unmatched_ignore_imports_alerting = warn

[importlinter:contract:data-storage-execution-isolation]
name = Data storage execution must not import other storage subdomains
type = forbidden
source_modules =
    ditto_data.storage.execution.**
forbidden_modules =
    ditto_data.storage.market.**
    ditto_data.storage.fundamental.**
    ditto_data.storage.capital.**
    ditto_data.storage.metadata.**
    ditto_data.storage.runtime.**
    ditto_data.storage.factors.**
    ditto_data.storage.features.**
    ditto_data.storage.macro.**
unmatched_ignore_imports_alerting = warn

# ═══════════════════════════════════════════════════════════════════
# 循环依赖检测
# 循环依赖检测
# ═══════════════════════════════════════════════════════════════════
[importlinter:contract:acyclic-packages]
name = No circular dependencies between packages
type = acyclic_siblings
ancestors =
    ditto_platform
    ditto_kernel
    ditto_data
    ditto_analytics
    ditto_engine
    ditto_application
    ditto_apps
depth = 10
unmatched_ignore_imports_alerting = warn
